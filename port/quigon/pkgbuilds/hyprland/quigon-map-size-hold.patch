+static std::unordered_map<const CWindow*, Time::steady_tp> s_quigonMappedAt;
+
+void Desktop::View::quigonNoteMapped(const CWindow* w) {
+    s_quigonMappedAt[w] = Time::steadyNow();
+}
+
+void Desktop::View::quigonForgetMapped(const CWindow* w) {
+    s_quigonMappedAt.erase(w);
+}
+
+std::optional<Time::steady_tp> Desktop::View::quigonMappedAt(const CWindow* w) {
+    const auto IT = s_quigonMappedAt.find(w);
+    return IT == s_quigonMappedAt.end() ? std::nullopt : std::optional{IT->second};
+}
