+            continue;
+        const auto PRED = g_layoutManager->predictSizeForNewTiledTarget().value_or(Vector2D{});
+        if (PRED.x > 0 && PRED.y > 0) {
+            Log::logger->log(Log::DEBUG, "Layout re-predicts size {} for unmapped {}", PRED, w);
+            w->m_xdgSurface->m_toplevel->setSize(PRED);
+        }
