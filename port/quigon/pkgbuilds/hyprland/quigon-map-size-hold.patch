+    // A toplevel that has been configured but isn't mapped yet got the layout's size prediction in its first
+    // configure, and that prediction may have depended on this window (dwindle predicts half of the focused window's
+    // tile). Re-send it, so the client draws its first frame for the layout it will actually get. Chrome's profile
+    // picker -> browser window: the browser window was configured for half the picker's tile, drew that after the
+    // picker had closed, and showed the stale half-width content (a line mid-window) until it re-rendered.
+    for (auto const& w : Desktop::windowState()->windows()) {
+        if (w == m_self.lock() || w->m_isMapped || w->m_isX11 || !w->m_xdgSurface || !w->m_xdgSurface->m_toplevel || w->m_xdgSurface->m_initialCommit)
