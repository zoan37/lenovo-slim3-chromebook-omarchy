@@ -174,6 +174,13 @@ static int vcodec_vpu_send_msg(struct vdec_vpu_inst *vpu, void *msg, int len)
 	if (err) {
 		mtk_vdec_err(vpu->ctx, "send fail vpu_id=%d msg_id=%X status=%d",
 			     id, msgid, err);
+		/*
+		 * The firmware acks a decode only once the core is done, so an
+		 * ack timeout is a hang like a missing interrupt: treat it the
