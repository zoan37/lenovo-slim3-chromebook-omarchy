diff --git a/drivers/clk/mediatek/clk-mt8189-vcodec.c b/drivers/clk/mediatek/clk-mt8189-vcodec.c
index 04b45c197..7e0a756f1 100644
--- a/drivers/clk/mediatek/clk-mt8189-vcodec.c
+++ b/drivers/clk/mediatek/clk-mt8189-vcodec.c
@@ -25,13 +25,24 @@ static const struct mtk_gate_regs vdec_core1_cg_regs = {
 	.sta_ofs = 0x8,
 };
 
+/*
+ * The vdec gates live in the VDE0 power domain but, as on ChromeOS, the
+ * provider does no runtime PM: their users (decoder core, larb4) power VDE0
+ * before enabling them. Runtime PM here (resuming the provider from inside
+ * clk_prepare, under the prepare lock, while larb4 resumes VDE0 and prepares
+ * clocks under the genpd lock) left the decoder resuming with its clocks off
+ * and then wedged the clock framework. CLK_IGNORE_UNUSED keeps
+ * clk_disable_unused() from touching them while VDE0 is off.
+ */
 #define GATE_VDEC_CORE0(_id, _name, _parent, _shift)			\
 	GATE_MTK_FLAGS(_id, _name, _parent, &vdec_core0_cg_regs, _shift,	\
-		       &mtk_clk_gate_ops_setclr_inv, CLK_OPS_PARENT_ENABLE)
+		       &mtk_clk_gate_ops_setclr_inv,			\
+		       CLK_OPS_PARENT_ENABLE | CLK_IGNORE_UNUSED)
 
 #define GATE_VDEC_CORE1(_id, _name, _parent, _shift)			\
 	GATE_MTK_FLAGS(_id, _name, _parent, &vdec_core1_cg_regs, _shift,	\
-		       &mtk_clk_gate_ops_setclr_inv, CLK_OPS_PARENT_ENABLE)
+		       &mtk_clk_gate_ops_setclr_inv,			\
+		       CLK_OPS_PARENT_ENABLE | CLK_IGNORE_UNUSED)
 
 static const struct mtk_gate vdec_core_clks[] = {
 	/* VDEC_CORE0 */
@@ -44,8 +55,6 @@ static const struct mtk_gate vdec_core_clks[] = {
 static const struct mtk_clk_desc vdec_core_desc = {
 	.clks = vdec_core_clks,
 	.num_clks = ARRAY_SIZE(vdec_core_clks),
-	/* registers live in the VDE0 power domain: power it for every access */
-	.need_runtime_pm = true,
 };
 
 static const struct mtk_gate_regs ven1_cg_regs = {
