diff --git a/drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_drv.c b/drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_drv.c
index de547594e..d5a7c39d2 100644
--- a/drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_drv.c
+++ b/drivers/media/platform/mediatek/vcodec/decoder/mtk_vcodec_dec_drv.c
@@ -395,6 +395,15 @@ static int mtk_vcodec_probe(struct platform_device *pdev)
 		return -ENODEV;
 	}
 	dma_set_max_seg_size(&pdev->dev, UINT_MAX);
+	/*
+	 * As ChromeOS: the decoder's IOMMU port sits in an IOVA region above 4 GiB
+	 * (MT8189 larb4: region 1, 4-8 GiB, see dma-ranges). With the default 32-bit
+	 * mask its buffers can't be mapped where the hardware looks, and the faults
+	 * land in an IOMMU bank whose interrupt isn't enabled: the decoder just hangs.
+	 */
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(36));
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "failed to set the DMA mask\n");
 
 	dev->fw_handler = mtk_vcodec_fw_select(dev, fw_type, DECODER);
 	if (IS_ERR(dev->fw_handler))
