From fa1b2bd763df57bf8a19f307a9485e79736c0092 Mon Sep 17 00:00:00 2001
From: quigon <quigon@localhost>
Date: Sat, 10 Oct 2026 16:04:36 -0400
Subject: [PATCH 2/2] clk: mediatek: mt8189-vcodec: venc provider without
 runtime PM, gates ignore-unused (as vdec_core): -EACCES in noirq resume left
 VEN0 marked on with its clocks off

---
 drivers/clk/mediatek/clk-mt8189-vcodec.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/mediatek/clk-mt8189-vcodec.c b/drivers/clk/mediatek/clk-mt8189-vcodec.c
index 7e0a756f1..3c2099e3e 100644
--- a/drivers/clk/mediatek/clk-mt8189-vcodec.c
+++ b/drivers/clk/mediatek/clk-mt8189-vcodec.c
@@ -65,7 +65,8 @@ static const struct mtk_gate_regs ven1_cg_regs = {
 
 #define GATE_VEN1(_id, _name, _parent, _shift)				\
 	GATE_MTK_FLAGS(_id, _name, _parent, &ven1_cg_regs, _shift,		\
-		       &mtk_clk_gate_ops_setclr_inv, CLK_OPS_PARENT_ENABLE)
+		       &mtk_clk_gate_ops_setclr_inv,			\
+		       CLK_OPS_PARENT_ENABLE | CLK_IGNORE_UNUSED)
 
 static const struct mtk_gate ven1_clks[] = {
 	GATE_VEN1(CLK_VEN1_CKE0_LARB, "ven1_larb", "venc_sel", 0),
@@ -80,8 +81,11 @@ static const struct mtk_gate ven1_clks[] = {
 static const struct mtk_clk_desc ven1_desc = {
 	.clks = ven1_clks,
 	.num_clks = ARRAY_SIZE(ven1_clks),
-	/* registers live in the VEN0 power domain: power it for every access */
-	.need_runtime_pm = true,
+	/*
+	 * The registers live in VEN0, but as for vdec_core (and on ChromeOS) the provider has no runtime PM: its users
+	 * power VEN0 first. With runtime PM, VEN0's own subsys clock (the larb gate) failed to prepare with -EACCES when
+	 * genpd powered the domain back on in the noirq resume phase, and genpd marked it on anyway (unbalanced clocks).
+	 */
 };
 
