From 958bafb5a6184f8a7f8093bde65230d2e1de3e27 Mon Sep 17 00:00:00 2001
From: quigon <quigon@localhost>
Date: Sun, 11 Oct 2026 15:09:45 -0400
Subject: [PATCH] clk: mediatek: mt8189: keep the GPU on MFGPLL (no reparent);
 quigon DT pins mfg_sel_mfgpll to mfgpll

GPU devfreq could move mfg_sel_mfgpll to mfg_ref_sel and retune MAINPLL (mainpll_d6) for 560/595 MHz, which
moved every mainpll-derived clock with it: the backlight PWM jumped from 2.0 to ~3 kHz for tens of ms, a visible
brightness flicker under GPU load.
---
 arch/arm64/boot/dts/mediatek/mt8189-quigon.dts | 7 +++++++
 drivers/clk/mediatek/clk-mt8189-topckgen.c     | 2 +-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt8189-quigon.dts b/arch/arm64/boot/dts/mediatek/mt8189-quigon.dts
index 7e50cdf81a8d..94d8ec370b58 100644
--- a/arch/arm64/boot/dts/mediatek/mt8189-quigon.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8189-quigon.dts
@@ -145,6 +145,13 @@ gpu: gpu@13000000 {
 				     <GIC_SPI 269 IRQ_TYPE_LEVEL_HIGH 0>;
 			interrupt-names = "job", "mmu", "gpu";
 			clocks = <&mfgcfg CLK_MFG_BG3D>;
+			/*
+			 * Keep the GPU on its own PLL: through mfg_ref_sel the clock framework would otherwise retune MAINPLL
+			 * (mainpll_d6) for some GPU frequencies, which also moves every other mainpll-derived clock (the
+			 * backlight PWM among them: brief brightness flicker under GPU load).
+			 */
+			assigned-clocks = <&topckgen CLK_TOP_MFG_SEL_MFGPLL>;
+			assigned-clock-parents = <&apmixedsys CLK_APMIXED_MFGPLL>;
 			power-domains = <&spm MT8189_POWER_DOMAIN_MFG2>,
 					<&spm MT8189_POWER_DOMAIN_MFG3>;
 			power-domain-names = "core0", "core1";
diff --git a/drivers/clk/mediatek/clk-mt8189-topckgen.c b/drivers/clk/mediatek/clk-mt8189-topckgen.c
index 6ed7661119b8..25432db8e5ca 100644
--- a/drivers/clk/mediatek/clk-mt8189-topckgen.c
+++ b/drivers/clk/mediatek/clk-mt8189-topckgen.c
@@ -869,7 +869,7 @@ static const struct mtk_mux top_muxes[] = {
 	GATE_CLR_SET_UPD_FLAGS(CLK_TOP_MFG_SEL_MFGPLL, "mfg_sel_mfgpll",
 			       mfg_sel_mfgpll_parents,
 			       0x510, 0x514, 0x0518, 16, 1, 0, -1, -1,
-			       CLK_SET_RATE_PARENT,
+			       CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT,
 			       mtk_mux_clr_set_upd_ops)
 };
 
