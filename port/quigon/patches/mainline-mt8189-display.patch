+static void mtk_edp_v2_initialize_settings(struct mtk_dp *mtk_dp)
+{
+	/* Frame start/end markers */
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC_P0_3_3F04, 0,
+			   FRAME_START_MARKER_0_DP_ENC_P0_3_MASK);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC_P0_3_3F08,
+			   FRAME_START_MARKER_1_DP_ENC_P0_3,
+			   FRAME_START_MARKER_1_DP_ENC_P0_3);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC_P0_3_3F0C,
+			   FRAME_END_MARKER_0_DP_ENC_P0_3,
+			   FRAME_END_MARKER_0_DP_ENC_P0_3);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC_P0_3_3F10,
+			   FRAME_END_MARKER_1_DP_ENC_P0_3,
+			   FRAME_END_MARKER_1_DP_ENC_P0_3);
+
+	/* Test bus selection */
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC1_P0_33C0, 0,
+			   SDP_TESTBUS_SEL_DP_ENC1_P0_MASK);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC1_P0_33C0,
+			   SDP_TESTBUS_SEL_BIT4_DP_ENC1_P0,
+			   SDP_TESTBUS_SEL_BIT4_DP_ENC1_P0);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC1_P0_33C4,
+			   DP_TX_ENCODER_TESTBUS_SEL_DP_ENC1_P0,
+			   DP_TX_ENCODER_TESTBUS_SEL_DP_ENC1_P0_MASK);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC_P0_3_3F28,
+			   DP_TX_SDP_PSR_AS_TESTBUS,
+			   DP_TX_SDP_PSR_AS_TESTBUS_MASK);
+
+	/* Release all TOP soft resets and set up the probe mux */
+	mtk_dp_update_bits(mtk_dp, MTK_DP_TOP_RESET_AND_PROBE,
+			   RG_SW_RST_MASK, RG_SW_RST_MASK);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_TOP_RESET_AND_PROBE,
+			   RG_PROBE_LOW_SEL, RG_PROBE_LOW_SEL_MASK);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_TOP_RESET_AND_PROBE,
+			   RG_PROBE_LOW_HIGH_SWAP, RG_PROBE_LOW_HIGH_SWAP);
+
+	mtk_dp_update_bits(mtk_dp, MTK_DP_TOP_IRQ_MASK,
+			   ENCODER_IRQ_MSK | TRANS_IRQ_MSK,
+			   ENCODER_IRQ_MSK | TRANS_IRQ_MSK);
+}
