+/*
+ * eDP TX v2: temporarily override the PHY power state machine with
+ * @state, wait for the bandgap/AUX LDO, then hand control back to HW.
+ */
+static void mtk_edp_phy_pwr_state_override(struct mtk_dp *mtk_dp, u32 state,
+					   bool wait_ready)
+{
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC_P0_3_3F44,
+			   PHY_PWR_STATE_OW_EN_DP_ENC_P0_3,
+			   PHY_PWR_STATE_OW_EN_DP_ENC_P0_3);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC_P0_3_3F44, state,
+			   PHY_PWR_STATE_OW_VALUE_DP_ENC_P0_3_MASK);
+	if (wait_ready)
+		mtk_edp_phyd_wait_aux_ldo_ready(mtk_dp);
+	mtk_dp_update_bits(mtk_dp, MTK_DP_ENC_P0_3_3F44, 0,
+			   PHY_PWR_STATE_OW_EN_DP_ENC_P0_3);
+}
