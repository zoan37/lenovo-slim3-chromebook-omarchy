+static void mtk_dvo_bridge_enable(struct drm_bridge *bridge,
+				  struct drm_atomic_commit *commit)
+{
+	struct mtk_dvo *dvo = bridge_to_dvo(bridge);
+
+	mtk_dvo_power_on(dvo);
+	mtk_dvo_set_display_mode(dvo, &dvo->mode);
+	mtk_dvo_enable(dvo);
