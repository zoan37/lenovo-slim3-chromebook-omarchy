diff --git a/drivers/phy/mediatek/phy-mtk-edp.c b/drivers/phy/mediatek/phy-mtk-edp.c
new file mode 100644
index 000000000..5bd04bea2
--- /dev/null
+++ b/drivers/phy/mediatek/phy-mtk-edp.c
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek Embedded DisplayPort PHY driver for the eDP TX v2 IP (MT8189)
+ *
+ * Copyright (c) 2019-2022 MediaTek Inc.
+ * Copyright (c) 2022 BayLibre
+ *
+ * Based on the ChromeOS phy-mtk-edp.c driver.
+ *
+ * Unlike the DP PHY found in MT8195, the PHY of this IP lives in its own
+ * register range (second "reg" entry of the eDP TX node). It is instantiated
+ * by the mtk_dp driver as a child platform device, which hands over a regmap
+ * for the PHY register range as platform data.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#define MTK_EDP_PHY_MAX_LANES		4
+
+/* PHYD (digital) per-lane register blocks */
+#define PHYD_DIG_LAN_OFFSET(n)		(0x1000 + 0x100 * (n))
+
+/* PHYD (digital) global register block */
+#define PHYD_DIG_GLB_OFFSET		0x1400
+
+#define PHYD_DIG_PLL_CTL_0		(PHYD_DIG_GLB_OFFSET + 0x10)
+#define FORCE_PWR_STATE_MASK			GENMASK(2, 0)
+#define FORCE_PWR_STATE_ALL_ON			0x7
+
+#define PHYD_DIG_PLL_CTL_1		(PHYD_DIG_GLB_OFFSET + 0x14)
+
+#define PHYD_DIG_SW_RST			(PHYD_DIG_GLB_OFFSET + 0x38)
+#define DP_GLB_SW_RST_PHYD			BIT(0)
+
+#define PHYD_DIG_BIT_RATE		(PHYD_DIG_GLB_OFFSET + 0x3c)
+
+#define PHYD_DIG_TX_CTL_0		(PHYD_DIG_GLB_OFFSET + 0x74)
+
+enum mtk_edp_phy_bit_rate {
+	MTK_EDP_PHY_RBR,
+	MTK_EDP_PHY_HBR,
+	MTK_EDP_PHY_HBR2,
+	MTK_EDP_PHY_HBR3,
+	MTK_EDP_PHY_RATE_MAX,
+};
+
+/**
+ * struct mtk_edp_phy_pdata - SoC specific eDP PHY data
+ * @tx_ln_en_mask:   Lane enable field in PHYD_DIG_TX_CTL_0
+ * @tx_ctl_clr_mask: Bits of PHYD_DIG_TX_CTL_0 cleared when setting lanes
+ * @bit_rate:        PHYD_DIG_BIT_RATE values for RBR/HBR/HBR2/HBR3
+ * @ssc_ctl:         SSC control bit in PHYD_DIG_PLL_CTL_1 (set = SSC off)
+ * @drv_force:       Offset of DRIVING_FORCE in each PHYD lane block
+ * @swing_mask:      Voltage swing field in DRIVING_FORCE
+ * @pre_emph_mask:   Pre-emphasis field in DRIVING_FORCE
+ */
+struct mtk_edp_phy_pdata {
+	u32 tx_ln_en_mask;
+	u32 tx_ctl_clr_mask;
+	u8 bit_rate[MTK_EDP_PHY_RATE_MAX];
+	u32 ssc_ctl;
+	u32 drv_force;
+	u32 swing_mask;
+	u32 pre_emph_mask;
+};
+
+struct mtk_edp_phy {
+	struct device *dev;
+	struct regmap *regs;
+	const struct mtk_edp_phy_pdata *pdata;
+};
+
+static void mtk_edp_phy_reset_swing_pre(struct mtk_edp_phy *edp_phy)
+{
+	const struct mtk_edp_phy_pdata *pdata = edp_phy->pdata;
+	int i;
+
+	for (i = 0; i < MTK_EDP_PHY_MAX_LANES; i++)
+		regmap_clear_bits(edp_phy->regs,
+				  PHYD_DIG_LAN_OFFSET(i) + pdata->drv_force,
+				  pdata->swing_mask | pdata->pre_emph_mask);
+}
+
+static int mtk_edp_phy_init(struct phy *phy)
+{
+	struct mtk_edp_phy *edp_phy = phy_get_drvdata(phy);
+
+	/* Force the PHYD power state machine to "all on" */
+	regmap_update_bits(edp_phy->regs, PHYD_DIG_PLL_CTL_0,
+			   FORCE_PWR_STATE_MASK, FORCE_PWR_STATE_ALL_ON);
+
+	return 0;
+}
+
+static int mtk_edp_phy_configure(struct phy *phy, union phy_configure_opts *opts)
+{
+	struct mtk_edp_phy *edp_phy = phy_get_drvdata(phy);
+	const struct mtk_edp_phy_pdata *pdata = edp_phy->pdata;
+	enum mtk_edp_phy_bit_rate rate;
+	u32 val;
+
+	if (opts->dp.set_rate) {
+		switch (opts->dp.link_rate) {
+		case 1620:
+			rate = MTK_EDP_PHY_RBR;
+			break;
+		case 2700:
+			rate = MTK_EDP_PHY_HBR;
+			break;
+		case 5400:
+			rate = MTK_EDP_PHY_HBR2;
+			break;
+		case 8100:
+			rate = MTK_EDP_PHY_HBR3;
+			break;
+		default:
+			dev_err(&phy->dev, "Unsupported link rate %u\n",
+				opts->dp.link_rate);
+			return -EINVAL;
+		}
+		regmap_write(edp_phy->regs, PHYD_DIG_BIT_RATE,
+			     pdata->bit_rate[rate]);
+	}
+
+	if (opts->dp.set_lanes) {
+		if (opts->dp.lanes > MTK_EDP_PHY_MAX_LANES) {
+			dev_err(&phy->dev, "Wrong lanes config %u\n",
+				opts->dp.lanes);
+			return -EINVAL;
+		}
+
+		/*
+		 * The ChromeOS driver clears the low nibble of TX_CTL_0 here
+		 * on MT8189; keep doing that, and enable the active lanes in
+		 * the lane enable field.
+		 */
+		val = 0;
+		if (opts->dp.lanes)
+			val = field_prep(pdata->tx_ln_en_mask,
+					 GENMASK(opts->dp.lanes - 1, 0));
+		regmap_update_bits(edp_phy->regs, PHYD_DIG_TX_CTL_0,
+				   pdata->tx_ctl_clr_mask | pdata->tx_ln_en_mask,
+				   val);
+	}
+
+	regmap_update_bits(edp_phy->regs, PHYD_DIG_PLL_CTL_1, pdata->ssc_ctl,
+			   opts->dp.ssc ? 0 : pdata->ssc_ctl);
+
+	return 0;
+}
+
+static int mtk_edp_phy_reset(struct phy *phy)
+{
+	struct mtk_edp_phy *edp_phy = phy_get_drvdata(phy);
+
+	/*
+	 * Make sure that PHYD is out of reset. Note that the ChromeOS driver
+	 * never actually pulses this reset (its assert write uses an empty
+	 * mask), so do not assert it here either: that is the sequence that
+	 * has been validated on MT8189 hardware.
+	 */
+	regmap_set_bits(edp_phy->regs, PHYD_DIG_SW_RST, DP_GLB_SW_RST_PHYD);
+	usleep_range(50, 200);
+
+	mtk_edp_phy_reset_swing_pre(edp_phy);
+
+	return 0;
+}
+
+static const struct phy_ops mtk_edp_phy_ops = {
+	.init = mtk_edp_phy_init,
+	.configure = mtk_edp_phy_configure,
+	.reset = mtk_edp_phy_reset,
+	.owner = THIS_MODULE,
+};
+
+static void mtk_edp_phy_remove_lookup(void *data)
+{
+	struct phy *phy = data;
+	struct mtk_edp_phy *edp_phy = phy_get_drvdata(phy);
+
+	phy_remove_lookup(phy, "dp", dev_name(edp_phy->dev));
+}
+
+static int mtk_edp_phy_probe(struct platform_device *pdev)
+{
+	const struct platform_device_id *id = platform_get_device_id(pdev);
+	struct device *dev = &pdev->dev;
+	struct mtk_edp_phy *edp_phy;
+	struct regmap **regs = dev_get_platdata(dev);
+	struct phy *phy;
+	int ret;
+
+	if (!regs || !*regs)
+		return dev_err_probe(dev, -EINVAL,
+				     "No PHY regmap passed as platform data\n");
+
+	edp_phy = devm_kzalloc(dev, sizeof(*edp_phy), GFP_KERNEL);
+	if (!edp_phy)
+		return -ENOMEM;
+
+	edp_phy->dev = dev;
+	edp_phy->regs = *regs;
+	edp_phy->pdata = (const struct mtk_edp_phy_pdata *)id->driver_data;
+
+	phy = devm_phy_create(dev, NULL, &mtk_edp_phy_ops);
+	if (IS_ERR(phy))
+		return dev_err_probe(dev, PTR_ERR(phy),
+				     "Failed to create eDP PHY\n");
+
+	phy_set_drvdata(phy, edp_phy);
+
+	ret = phy_create_lookup(phy, "dp", dev_name(dev));
+	if (ret)
+		return ret;
+
+	return devm_add_action_or_reset(dev, mtk_edp_phy_remove_lookup, phy);
