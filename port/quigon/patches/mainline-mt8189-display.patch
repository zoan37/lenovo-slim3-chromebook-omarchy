+static int mtk_dvo_bridge_attach(struct drm_bridge *bridge,
+				 struct drm_encoder *encoder,
+				 enum drm_bridge_attach_flags flags)
+{
+	struct mtk_dvo *dvo = bridge_to_dvo(bridge);
+	int ret;
+
+	ret = drm_bridge_attach(encoder, dvo->next_bridge, &dvo->bridge, flags);
+	if (ret)
+		dev_err(dvo->dev, "Failed to attach next bridge: %d\n", ret);
+
+	return ret;
+}
