+static int mtk_edp_phyd_wait_aux_ldo_ready(struct mtk_dp *mtk_dp)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read_poll_timeout(mtk_dp->phy_regs,
+				       MTK_EDP_PHYD_DIG_GLB_STATUS_0, val,
+				       val & (RGS_BG_CORE_EN_READY |
+					      RGS_AUX_LDO_EN_READY),
+				       MTK_EDP_AUX_LDO_READY_TIMEOUT_US / 100,
+				       MTK_EDP_AUX_LDO_READY_TIMEOUT_US);
+	if (ret)
+		dev_err(mtk_dp->dev, "eDP PHY bandgap/AUX LDO not ready\n");
+
+	return ret;
+}
