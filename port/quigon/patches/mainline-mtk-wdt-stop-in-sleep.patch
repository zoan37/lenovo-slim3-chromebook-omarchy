From 95a2201fa79a1f6d0bdc37b451c38963d3039c2c Mon Sep 17 00:00:00 2001
From: quigon <quigon@localhost>
Date: Sat, 10 Oct 2026 12:40:29 -0400
Subject: [PATCH] watchdog: mtk_wdt: stop a watchdog armed at boot over system
 sleep too (it reset the SoC ~30 s into a sleep)

---
 drivers/watchdog/mtk_wdt.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/watchdog/mtk_wdt.c b/drivers/watchdog/mtk_wdt.c
index 3b5b0d281..930390bea 100644
--- a/drivers/watchdog/mtk_wdt.c
+++ b/drivers/watchdog/mtk_wdt.c
@@ -594,7 +594,11 @@ static int mtk_wdt_suspend(struct device *dev)
 	if (keep_in_suspend)
 		return 0;
 
-	if (watchdog_active(&mtk_wdt->wdt_dev))
+	/*
+	 * Also when only the kernel feeds it (armed at boot, mtk_wdt.start_timeout, userspace not attached yet or at
+	 * all): nobody pings it while the system sleeps, so it would reset the SoC some 30 s into any longer sleep.
+	 */
+	if (watchdog_active(&mtk_wdt->wdt_dev) || watchdog_hw_running(&mtk_wdt->wdt_dev))
 		mtk_wdt_stop(&mtk_wdt->wdt_dev);
 
 	return 0;
@@ -607,7 +611,7 @@ static int mtk_wdt_resume(struct device *dev)
 	if (keep_in_suspend)
 		return 0;
 
-	if (watchdog_active(&mtk_wdt->wdt_dev)) {
+	if (watchdog_active(&mtk_wdt->wdt_dev) || watchdog_hw_running(&mtk_wdt->wdt_dev)) {
 		mtk_wdt_start(&mtk_wdt->wdt_dev);
 		mtk_wdt_ping(&mtk_wdt->wdt_dev);
 	}
-- 
