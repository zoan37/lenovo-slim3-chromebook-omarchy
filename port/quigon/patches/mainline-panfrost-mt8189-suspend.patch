diff --git a/drivers/gpu/drm/panfrost/panfrost_device.c b/drivers/gpu/drm/panfrost/panfrost_device.c
index 485349faf..a795a4ca7 100644
--- a/drivers/gpu/drm/panfrost/panfrost_device.c
+++ b/drivers/gpu/drm/panfrost/panfrost_device.c
@@ -490,23 +490,55 @@ static int panfrost_device_runtime_suspend(struct device *dev)
 	return 0;
 }
 
+/* Hold (or release) the GPU power domains around clock gate writes on SoCs where the gates sit inside them. */
+static void panfrost_pm_domains_hold(struct panfrost_device *pfdev, bool hold)
+{
+	int i;
+
+	if (!(pfdev->comp->pm_features & BIT(GPU_PM_DOMAINS_FOR_CLK)))
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(pfdev->pm_domain_devs); i++) {
+		if (!pfdev->pm_domain_devs[i])
+			continue;
+		if (hold)
+			pm_runtime_get_sync(pfdev->pm_domain_devs[i]);
+		else
+			pm_runtime_put(pfdev->pm_domain_devs[i]);
+	}
+}
+
 static int panfrost_device_resume(struct device *dev)
 {
 	struct panfrost_device *pfdev = dev_get_drvdata(dev);
 	int ret;
 
+	/* before the OPP (clock rate, regulators) and the clock gates: on MT8189 they need the GPU domains up */
+	panfrost_pm_domains_hold(pfdev, true);
+
 	if (pfdev->comp->pm_features & BIT(GPU_PM_VREG_OFF)) {
 		unsigned long freq = pfdev->pfdevfreq.fast_rate;
 		struct dev_pm_opp *opp;
 
 		opp = dev_pm_opp_find_freq_ceil(dev, &freq);
-		if (IS_ERR(opp))
+		if (IS_ERR(opp)) {
+			panfrost_pm_domains_hold(pfdev, false);
 			return PTR_ERR(opp);
+		}
 		dev_pm_opp_set_opp(dev, opp);
 		dev_pm_opp_put(opp);
 	}
 
 	if (pfdev->comp->pm_features & BIT(GPU_PM_CLK_DIS)) {
+		/*
+		 * MT8189: preparing the gate powers its clock controller (runtime PM), whose registers sit in
+		 * the GPU power domain; the gate was unprepared in suspend.
+		 */
+		if (pfdev->comp->pm_features & BIT(GPU_PM_DOMAINS_FOR_CLK)) {
+			ret = clk_prepare(pfdev->clock);
+			if (ret)
+				goto err_clk;
+		}
 		ret = clk_enable(pfdev->clock);
 		if (ret)
 			goto err_clk;
@@ -522,6 +554,7 @@ static int panfrost_device_resume(struct device *dev)
 	if (ret)
 		goto err_resume;
 
+	panfrost_pm_domains_hold(pfdev, false);
 	return 0;
 
 err_resume:
@@ -533,6 +566,7 @@ static int panfrost_device_resume(struct device *dev)
 err_clk:
 	if (pfdev->comp->pm_features & BIT(GPU_PM_VREG_OFF))
 		dev_pm_opp_set_opp(dev, NULL);
+	panfrost_pm_domains_hold(pfdev, false);
 	return ret;
 }
 
@@ -541,17 +575,25 @@ static int panfrost_device_suspend(struct device *dev)
 	struct panfrost_device *pfdev = dev_get_drvdata(dev);
 	int ret;
 
+	panfrost_pm_domains_hold(pfdev, true);
+
 	ret = pm_runtime_force_suspend(dev);
-	if (ret)
+	if (ret) {
+		panfrost_pm_domains_hold(pfdev, false);
 		return ret;
+	}
 
 	if (pfdev->comp->pm_features & BIT(GPU_PM_CLK_DIS)) {
 		if (pfdev->bus_clock)
 			clk_disable(pfdev->bus_clock);
 
 		clk_disable(pfdev->clock);
+		if (pfdev->comp->pm_features & BIT(GPU_PM_DOMAINS_FOR_CLK))
+			clk_unprepare(pfdev->clock);
 	}
 
+	panfrost_pm_domains_hold(pfdev, false);
+
 	if (pfdev->comp->pm_features & BIT(GPU_PM_VREG_OFF))
 		dev_pm_opp_set_opp(dev, NULL);
 
diff --git a/drivers/gpu/drm/panfrost/panfrost_device.h b/drivers/gpu/drm/panfrost/panfrost_device.h
index 1fe1554f2..86df8136e 100644
--- a/drivers/gpu/drm/panfrost/panfrost_device.h
+++ b/drivers/gpu/drm/panfrost/panfrost_device.h
@@ -41,12 +41,15 @@ enum panfrost_drv_comp_bits {
  * enum panfrost_gpu_pm - Supported kernel power management features
  * @GPU_PM_CLK_DIS:  Allow disabling clocks during system suspend
  * @GPU_PM_VREG_OFF: Allow turning off regulators during system suspend
+ * @GPU_PM_DOMAINS_FOR_CLK: The clock gates live inside the GPU power domains (MT8189): keep the
+ *                          domains powered while the clocks are switched in system suspend/resume
  * @GPU_PM_RT: Allow disabling clocks and asserting the reset control during
  *  system runtime suspend
  */
 enum panfrost_gpu_pm {
 	GPU_PM_CLK_DIS,
 	GPU_PM_VREG_OFF,
+	GPU_PM_DOMAINS_FOR_CLK,
 	GPU_PM_RT
 };
 
diff --git a/drivers/gpu/drm/panfrost/panfrost_drv.c b/drivers/gpu/drm/panfrost/panfrost_drv.c
index 5a44b7ca0..3b143a6af 100644
--- a/drivers/gpu/drm/panfrost/panfrost_drv.c
