 	.gpu_quirks = BIT(GPU_QUIRK_FORCE_AARCH64_PGTABLE),
 };
 
+/* MT8189: like MT8370, but its MFG clock gate sits inside the GPU power domains */
+static const struct panfrost_compatible mediatek_mt8189_data = {
+	.num_supplies = ARRAY_SIZE(default_supplies) - 1,
+	.supply_names = default_supplies,
+	.num_pm_domains = 2,
+	.pm_domain_names = mediatek_pm_domains,
+	/*
+	 * No clock/regulator switching in system sleep: the MFG clock gate sits inside the GPU power domains, and
+	 * re-enabling it (or the OPP) on resume faulted or hung. System sleep then only runtime-suspends the GPU,
+	 * like an idle period.
+	 */
+	.pm_features = 0,
+	.gpu_quirks = BIT(GPU_QUIRK_FORCE_AARCH64_PGTABLE),
+};
+
 static const struct of_device_id dt_match[] = {
 	/* Set first to probe before the generic compatibles */
 	{ .compatible = "amlogic,meson-gxm-mali",
@@ -1177,7 +1192,7 @@ static const struct of_device_id dt_match[] = {
 	{ .compatible = "mediatek,mt8186-mali", .data = &mediatek_mt8186_data },
 	{ .compatible = "mediatek,mt8188-mali", .data = &mediatek_mt8188_data },
 	{ .compatible = "mediatek,mt8192-mali", .data = &mediatek_mt8192_data },
-	{ .compatible = "mediatek,mt8189-mali", .data = &mediatek_mt8370_data },
+	{ .compatible = "mediatek,mt8189-mali", .data = &mediatek_mt8189_data },
 	{ .compatible = "mediatek,mt8370-mali", .data = &mediatek_mt8370_data },
 	{ .compatible = "allwinner,sun50i-h616-mali", .data = &default_pm_rt_data },
 	{}
