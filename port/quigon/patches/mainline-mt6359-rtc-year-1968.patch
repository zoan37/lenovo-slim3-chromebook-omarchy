diff --git a/drivers/rtc/rtc-mt6397.c b/drivers/rtc/rtc-mt6397.c
index d6e156516..22391896d 100644
--- a/drivers/rtc/rtc-mt6397.c
+++ b/drivers/rtc/rtc-mt6397.c
@@ -100,6 +100,8 @@ static int mtk_rtc_read_time(struct device *dev, struct rtc_time *tm)
 	/* HW register start mon/wday from one, but tm_mon/tm_wday start from zero. */
 	tm->tm_mon--;
 	tm->tm_wday--;
+	if (rtc->data->year_base_1968)
+		tm->tm_year += RTC_YEAR_BASE_1968_OFFSET;
 
 exit:
 	return ret;
@@ -113,6 +115,8 @@ static int mtk_rtc_set_time(struct device *dev, struct rtc_time *tm)
 
 	tm->tm_mon++;
 	tm->tm_wday++;
+	if (rtc->data->year_base_1968)
+		tm->tm_year -= RTC_YEAR_BASE_1968_OFFSET;
 
 	data[RTC_OFFSET_SEC] = tm->tm_sec;
 	data[RTC_OFFSET_MIN] = tm->tm_min;
@@ -167,6 +171,8 @@ static int mtk_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *alm)
 	tm->tm_mday = data[RTC_OFFSET_DOM] & RTC_AL_DOM_MASK;
 	tm->tm_mon = data[RTC_OFFSET_MTH] & RTC_AL_MTH_MASK;
 	tm->tm_year = data[RTC_OFFSET_YEAR] & RTC_AL_YEA_MASK;
+	if (rtc->data->year_base_1968)
+		tm->tm_year += RTC_YEAR_BASE_1968_OFFSET;
 
 	tm->tm_mon--;
 
@@ -182,7 +188,10 @@ static int mtk_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *alm)
 	struct mt6397_rtc *rtc = dev_get_drvdata(dev);
 	int ret;
 	u16 data[RTC_OFFSET_COUNT];
+	int year = tm->tm_year;
 
+	if (rtc->data->year_base_1968)
+		year -= RTC_YEAR_BASE_1968_OFFSET;
 	tm->tm_mon++;
 
 	mutex_lock(&rtc->lock);
@@ -202,7 +211,7 @@ static int mtk_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *alm)
 	data[RTC_OFFSET_MTH] = ((data[RTC_OFFSET_MTH] & ~(RTC_AL_MTH_MASK)) |
 				(tm->tm_mon & RTC_AL_MTH_MASK));
 	data[RTC_OFFSET_YEAR] = ((data[RTC_OFFSET_YEAR] & ~(RTC_AL_YEA_MASK)) |
-				(tm->tm_year & RTC_AL_YEA_MASK));
+				(year & RTC_AL_YEA_MASK));
 
 	if (alm->enabled) {
 		ret = regmap_bulk_write(rtc->regmap,
@@ -371,10 +380,16 @@ static int mtk_rtc_probe(struct platform_device *pdev)
 	device_init_wakeup(&pdev->dev, true);
 
 	rtc->rtc_dev->ops = &mtk_rtc_ops;
-	rtc->rtc_dev->range_min = RTC_TIMESTAMP_BEGIN_1900;
-	rtc->rtc_dev->range_max = mktime64(2027, 12, 31, 23, 59, 59);
-	rtc->rtc_dev->start_secs = mktime64(1968, 1, 2, 0, 0, 0);
-	rtc->rtc_dev->set_start_time = true;
+	if (rtc->data->year_base_1968) {
+		/* 7-bit year counted from 1968, as the boot firmware and ChromeOS keep it */
+		rtc->rtc_dev->range_min = mktime64(1968, 1, 1, 0, 0, 0);
+		rtc->rtc_dev->range_max = mktime64(2095, 12, 31, 23, 59, 59);
+	} else {
+		rtc->rtc_dev->range_min = RTC_TIMESTAMP_BEGIN_1900;
+		rtc->rtc_dev->range_max = mktime64(2027, 12, 31, 23, 59, 59);
+		rtc->rtc_dev->start_secs = mktime64(1968, 1, 2, 0, 0, 0);
+		rtc->rtc_dev->set_start_time = true;
+	}
 
 	ret = devm_rtc_register_device(rtc->rtc_dev);
 	if (ret)
@@ -412,6 +427,7 @@ static SIMPLE_DEV_PM_OPS(mt6397_pm_ops, mt6397_rtc_suspend,
 
 static const struct mtk_rtc_data mt6358_rtc_data = {
 	.wrtgr = RTC_WRTGR_MT6358,
+	.year_base_1968 = true,
 };
 
 static const struct mtk_rtc_data mt6397_rtc_data = {
diff --git a/include/linux/mfd/mt6397/rtc.h b/include/linux/mfd/mt6397/rtc.h
index f4da579ec..ea3185894 100644
--- a/include/linux/mfd/mt6397/rtc.h
+++ b/include/linux/mfd/mt6397/rtc.h
@@ -70,8 +70,12 @@
 #define MTK_RTC_POLL_DELAY_US  10
 #define MTK_RTC_POLL_TIMEOUT   (jiffies_to_usecs(HZ))
 
+/* MT6358/MT6359: the boot firmware (and ChromeOS) keep the 7-bit year register as year - 1968 */
+#define RTC_YEAR_BASE_1968_OFFSET	(1968 - 1900)
+
 struct mtk_rtc_data {
 	u32                     wrtgr;
+	bool                    year_base_1968;
 };
 
 struct mt6397_rtc {
