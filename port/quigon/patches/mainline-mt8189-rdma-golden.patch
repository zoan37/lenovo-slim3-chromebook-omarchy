From c018c428e60054a37cbaa54e98bfcc7e7dd43aae Mon Sep 17 00:00:00 2001
From: quigon <quigon@localhost>
Date: Sat, 10 Oct 2026 12:21:18 -0400
Subject: [PATCH 1/2] quigon: MT8189 display RDMA: ChromeOS golden settings
 (2200-entry FIFO, pre-ultra/ultra thresholds, 10-bit mode)

---
 drivers/gpu/drm/mediatek/mtk_disp_rdma.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_disp_rdma.c b/drivers/gpu/drm/mediatek/mtk_disp_rdma.c
index 593d9d144..cd9855b91 100644
--- a/drivers/gpu/drm/mediatek/mtk_disp_rdma.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_rdma.c
@@ -45,6 +45,8 @@
 #define MEM_MODE_INPUT_SWAP				BIT(8)
 #define DISP_RDMA_MEM_SRC_PITCH			0x002c
 #define DISP_RDMA_MEM_GMC_SETTING_0		0x0030
+#define DISP_RDMA_MEM_GMC_SETTING_1		0x0034
+#define RDMA_10BIT_MODE					BIT(3)
 #define DISP_REG_RDMA_FIFO_CON			0x0040
 #define RDMA_FIFO_UNDERFLOW_EN				BIT(31)
 #define RDMA_FIFO_PSEUDO_SIZE(bytes)			(((bytes) / 16) << 16)
@@ -72,6 +74,9 @@ struct mtk_disp_rdma_data {
 	unsigned int fifo_size;
 	const u32 *formats;
 	size_t num_formats;
+	/* MT8189 (ChromeOS golden setting): pre-ultra/ultra memory priority thresholds, 10-bit datapath */
+	unsigned int ultra_gap;
+	bool need_ultra;
 };
 
 /*
@@ -211,6 +216,19 @@ void mtk_rdma_config(struct device *dev, unsigned int width,
 	      RDMA_FIFO_PSEUDO_SIZE(rdma_fifo_size) |
 	      RDMA_OUTPUT_VALID_FIFO_THRESHOLD(threshold);
 	mtk_ddp_write(cmdq_pkt, reg, &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_FIFO_CON);
+
+	if (rdma->data->need_ultra) {
+		u32 pre_ultra_low = rdma_fifo_size * 6 / 10;
+		u32 ultra_low = rdma_fifo_size * 5 / 10;
+		u32 gap = rdma->data->ultra_gap;
+
+		mtk_ddp_write(cmdq_pkt, pre_ultra_low | ((pre_ultra_low + gap) << 16),
+			      &rdma->cmdq_reg, rdma->regs, DISP_RDMA_MEM_GMC_SETTING_0);
+		mtk_ddp_write(cmdq_pkt, ultra_low | ((ultra_low + gap) << 16),
+			      &rdma->cmdq_reg, rdma->regs, DISP_RDMA_MEM_GMC_SETTING_1);
+		mtk_ddp_write_mask(cmdq_pkt, RDMA_10BIT_MODE, &rdma->cmdq_reg, rdma->regs,
+				   DISP_REG_RDMA_GLOBAL_CON, RDMA_10BIT_MODE);
+	}
 }
 
 static unsigned int rdma_fmt_convert(struct mtk_disp_rdma *rdma,
@@ -395,9 +413,11 @@ static const struct mtk_disp_rdma_data mt8183_rdma_driver_data = {
 };
 
 static const struct mtk_disp_rdma_data mt8189_rdma_driver_data = {
-	.fifo_size = 1920,
+	.fifo_size = 2200,
 	.formats = mt8173_formats,
 	.num_formats = ARRAY_SIZE(mt8173_formats),
+	.ultra_gap = 440,
+	.need_ultra = true,
 };
 
 static const struct mtk_disp_rdma_data mt8195_rdma_driver_data = {
-- 
