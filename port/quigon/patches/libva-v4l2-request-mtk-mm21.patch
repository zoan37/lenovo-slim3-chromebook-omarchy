+/* One output texel = 4 consecutive bytes of an NV12 plane row, all within one
+ * 16-byte tile row: fetch them as one RGBA8 texel of the linear view. */
+/* One output texel = 4 consecutive bytes of an NV12 plane row, all within one
+ * 16-byte tile row: fetch them as one RGBA8 texel of the linear view. Mali has
+ * no integer divider, so tile sizes are shifts and the one division (by the
+ * row stride, to find the texel's row in the linear view) a float multiply:
+ * R < 2^17 is exact in a float and the +0.5 keeps the floor exact. */
+static const char *fs_src =
+	"#version 300 es\n"
+	"precision highp float;\n"
+	"precision highp int;\n"
+	"uniform highp sampler2D src;\n"
+	"uniform int stride;\n"
+	"uniform int th_shift;\n"
+	"uniform float inv_stride;\n"
+	"out vec4 color;\n"
+	"void main() {\n"
+	"	int fx = int(gl_FragCoord.x);\n"
+	"	int y = int(gl_FragCoord.y);\n"
+	"	int r = ((fx >> 2) << (th_shift + 4)) + ((y & ((1 << th_shift) - 1)) << 4) + ((fx & 3) << 2);\n"
+	"	int q = int((float(r) + 0.5) * inv_stride);\n"
+	"	int rem = r - q * stride;\n"
+	"	color = texelFetch(src, ivec2(rem >> 2, ((y >> th_shift) << th_shift) + q), 0);\n"
+	"}\n";
+
+static bool panfrost_present(void)
+{
+	return access("/sys/module/panfrost", F_OK) == 0;
+}
+
+static GLuint compile(GLenum type, const char *src)
+{
+	GLuint s = p_glCreateShader(type);
+	GLint ok = 0;
+
+	p_glShaderSource(s, 1, &src, NULL);
+	p_glCompileShader(s);
+	p_glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[512] = "";
+
+		p_glGetShaderInfoLog(s, sizeof(log), NULL, log);
+		v4l2r_log("GL detile: shader: %s\n", log);
+		return 0;
+	}
+	return s;
+}
+
+static bool gl_init(void)
+{
+	void *lib;
+	PFNEGLGETPROCADDRESSPROC gpa;
+	EGLint major, minor;
+	const char *ext;
+	static const EGLint ctx_attr[] = { EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE };
+	GLuint vs, fs;
+	GLint linked = 0;
+
+	if (!panfrost_present())
+		return false;
+
+	lib = dlopen("libEGL.so.1", RTLD_NOW | RTLD_LOCAL);
+	if (!lib)
+		return false;
+	gpa = (PFNEGLGETPROCADDRESSPROC)dlsym(lib, "eglGetProcAddress");
+	if (!gpa)
+		return false;
+#define RESOLVE(type, name) \
+	if (!(p_##name = (type)gpa(#name))) { v4l2r_log("GL detile: no %s\n", #name); return false; }
+	EGL_FUNCS(RESOLVE)
+
+	gl.dpy = p_eglGetPlatformDisplayEXT(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, NULL);
+	if (gl.dpy == EGL_NO_DISPLAY || !p_eglInitialize(gl.dpy, &major, &minor))
+		return false;
+	ext = p_eglQueryString(gl.dpy, EGL_EXTENSIONS);
+	if (!ext || !strstr(ext, "EGL_EXT_image_dma_buf_import") ||
+	    !strstr(ext, "EGL_KHR_surfaceless_context") || !strstr(ext, "EGL_KHR_no_config_context")) {
+		v4l2r_log("GL detile: EGL lacks dma-buf import or surfaceless contexts\n");
+		return false;
+	}
+	if (!p_eglBindAPI(EGL_OPENGL_ES_API))
+		return false;
+	gl.ctx = p_eglCreateContext(gl.dpy, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, ctx_attr);
+	if (gl.ctx == EGL_NO_CONTEXT)
+		return false;
+	if (!p_eglMakeCurrent(gl.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, gl.ctx))
+		return false;
+	GL_FUNCS(RESOLVE)
+#undef RESOLVE
+
+	vs = compile(GL_VERTEX_SHADER, vs_src);
+	fs = compile(GL_FRAGMENT_SHADER, fs_src);
+	if (!vs || !fs)
+		goto fail;
+	gl.prog = p_glCreateProgram();
+	p_glAttachShader(gl.prog, vs);
+	p_glAttachShader(gl.prog, fs);
+	p_glLinkProgram(gl.prog);
+	p_glGetProgramiv(gl.prog, GL_LINK_STATUS, &linked);
+	if (!linked)
+		goto fail;
+	gl.u_src = p_glGetUniformLocation(gl.prog, "src");
+	gl.u_stride = p_glGetUniformLocation(gl.prog, "stride");
+	gl.u_th_shift = p_glGetUniformLocation(gl.prog, "th_shift");
+	gl.u_inv_stride = p_glGetUniformLocation(gl.prog, "inv_stride");
+	p_glGenVertexArrays(1, &gl.vao);
+	p_eglMakeCurrent(gl.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+	v4l2r_log("detiling MM21 on the GPU (EGL %d.%d)\n", major, minor);
+	return true;
+fail:
+	p_eglMakeCurrent(gl.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+	return false;
+}
+
+/* An imported RGBA8 view of (fd, offset): width texels, height rows, pitch
+ * bytes. Cached by the dma-buf's inode, which stays unique while it lives. */
+static struct gl_image *get_image(int fd, uint32_t offset, uint32_t width,
+				  uint32_t height, uint32_t pitch, bool target)
+{
+	struct stat st;
+	struct gl_image *im, *victim = &gl.images[0];
+	EGLint attr[] = {
+		EGL_WIDTH, (EGLint)width,
+		EGL_HEIGHT, (EGLint)height,
+		EGL_LINUX_DRM_FOURCC_EXT, DRM_FORMAT_ABGR8888,
+		EGL_DMA_BUF_PLANE0_FD_EXT, fd,
+		EGL_DMA_BUF_PLANE0_OFFSET_EXT, (EGLint)offset,
+		EGL_DMA_BUF_PLANE0_PITCH_EXT, (EGLint)pitch,
+		EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, (EGLint)(DRM_FORMAT_MOD_LINEAR & 0xffffffff),
+		EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, (EGLint)(DRM_FORMAT_MOD_LINEAR >> 32),
+		EGL_NONE
+	};
+
+	if (fstat(fd, &st))
+		return NULL;
+	for (int i = 0; i < IMAGE_CACHE; i++) {
+		im = &gl.images[i];
+		if (im->image && im->dev == st.st_dev && im->ino == st.st_ino &&
+		    im->offset == offset && im->width == width && im->height == height &&
+		    im->pitch == pitch && (!target || im->fbo)) {
+			im->used = ++gl.tick;
+			return im;
+		}
+		if (!im->image || im->used < victim->used)
+			victim = im;
+	}
+
+	im = victim;
+	v4l2r_trace("GL detile: import %ux%u pitch %u%s\n", width, height, pitch, target ? " (target)" : "");
+	if (im->image) {
+		if (im->fbo)
+			p_glDeleteFramebuffers(1, &im->fbo);
+		p_glDeleteTextures(1, &im->tex);
+		p_eglDestroyImageKHR(gl.dpy, im->image);
+		memset(im, 0, sizeof(*im));
+	}
+	im->image = p_eglCreateImageKHR(gl.dpy, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, NULL, attr);
+	if (im->image == EGL_NO_IMAGE_KHR) {
+		v4l2r_log("GL detile: dma-buf import failed (0x%x)\n", p_eglGetError());
+		im->image = NULL;
+		return NULL;
+	}
+	p_glGenTextures(1, &im->tex);
+	p_glBindTexture(GL_TEXTURE_2D, im->tex);
+	p_glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, (GLeglImageOES)im->image);
+	p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	if (target) {
+		p_glGenFramebuffers(1, &im->fbo);
+		p_glBindFramebuffer(GL_FRAMEBUFFER, im->fbo);
+		p_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, im->tex, 0);
+		if (p_glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+			v4l2r_log("GL detile: NV12 plane not renderable\n");
+			p_glDeleteFramebuffers(1, &im->fbo);
+			p_glDeleteTextures(1, &im->tex);
+			p_eglDestroyImageKHR(gl.dpy, im->image);
+			memset(im, 0, sizeof(*im));
+			return NULL;
+		}
+	}
+	im->dev = st.st_dev;
+	im->ino = st.st_ino;
+	im->offset = offset;
+	im->width = width;
+	im->height = height;
+	im->pitch = pitch;
+	im->used = ++gl.tick;
+	return im;
+}
+
+static bool detile_plane(const struct v4l2r_gl_plane *src, int dst_fd, uint32_t dst_offset,
+			 uint32_t dst_pitch, uint32_t width, uint32_t height, int tile_h)
+{
+	struct gl_image *in, *out;
+
+	in = get_image(src->fd, src->offset, src->stride / 4, src->rows, src->stride, false);
+	out = get_image(dst_fd, dst_offset, width / 4, height, dst_pitch, true);
+	if (!in || !out)
+		return false;
+
+	p_glBindFramebuffer(GL_FRAMEBUFFER, out->fbo);
+	p_glViewport(0, 0, width / 4, height);
+	p_glActiveTexture(GL_TEXTURE0);
+	p_glBindTexture(GL_TEXTURE_2D, in->tex);
+	p_glUniform1i(gl.u_src, 0);
+	p_glUniform1i(gl.u_stride, src->stride);
+	p_glUniform1i(gl.u_th_shift, tile_h == 32 ? 5 : 4);
+	p_glUniform1f(gl.u_inv_stride, 1.0f / (float)src->stride);
+	p_glDrawArrays(GL_TRIANGLES, 0, 3);
+	return true;
+}
+
+bool v4l2r_gl_detile(const struct v4l2r_gl_plane *y, const struct v4l2r_gl_plane *uv,
+		     int dst_fd, uint32_t dst_pitch, uint32_t dst_uv_offset,
+		     uint32_t width, uint32_t height)
+{
+	EGLDisplay prev_dpy;
+	EGLContext prev_ctx;
+	EGLSurface prev_draw, prev_read;
+	bool ok = false;
+
+	if (width % 16 || !width || !height)
+		return false;
+
+	pthread_mutex_lock(&gl.lock);
+	if (!gl.tried) {
+		const char *env = getenv("V4L2R_GL_DETILE");
+
+		gl.tried = true;
+		gl.ok = !(env && env[0] == '0') && gl_init();
+	}
+	if (!gl.ok)
+		goto out;
+
+	prev_dpy = p_eglGetCurrentDisplay();
+	prev_ctx = p_eglGetCurrentContext();
+	prev_draw = p_eglGetCurrentSurface(EGL_DRAW);
+	prev_read = p_eglGetCurrentSurface(EGL_READ);
+	if (!p_eglMakeCurrent(gl.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, gl.ctx))
+		goto out;
+
+	p_glUseProgram(gl.prog);
+	p_glBindVertexArray(gl.vao);
+	ok = detile_plane(y, dst_fd, 0, dst_pitch, width, height, 32) &&
+	     detile_plane(uv, dst_fd, dst_uv_offset, dst_pitch, width, height / 2, 16);
+	/* The surface goes to the consumer right after this returns. */
+	p_glFinish();
+	if (p_glGetError() != GL_NO_ERROR)
+		ok = false;
+
+	if (prev_ctx != EGL_NO_CONTEXT)
+		p_eglMakeCurrent(prev_dpy, prev_draw, prev_read, prev_ctx);
+	else
+		p_eglMakeCurrent(gl.dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+out:
+	pthread_mutex_unlock(&gl.lock);
+	return ok;
+}
