+/*
+ * NV12 backing from the dma-buf system heap, for decoders whose CAPTURE
+ * queue cannot produce NV12 at all (mtk-vcodec-dec only does MM21). The
+ * CPU converter fills it; consumers import it like any other dma-buf.
+ */
+static VAStatus backing_alloc_heap(struct v4l2r_surface *surface,
+				   uint32_t width, uint32_t height,
+				   uint32_t pitch)
+{
+	struct v4l2r_surface_backing *backing;
+	struct dma_heap_allocation_data alloc = {0};
+	int heap;
+
+	height = (height + 1) & ~1u;
+	if (!pitch)
+		pitch = (width + 63) & ~63u;
+
+	heap = open("/dev/dma_heap/system", O_RDWR | O_CLOEXEC);
+	if (heap < 0) {
+		v4l2r_log("cannot open /dev/dma_heap/system: %s\n",
+			  strerror(errno));
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+	}
+
+	alloc.len = (uint64_t)pitch * height * 3 / 2;
+	alloc.fd_flags = O_RDWR | O_CLOEXEC;
+	if (ioctl(heap, DMA_HEAP_IOCTL_ALLOC, &alloc) < 0) {
+		v4l2r_log("dma-heap allocation of %llu bytes failed: %s\n",
+			  (unsigned long long)alloc.len, strerror(errno));
+		close(heap);
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+	}
+	close(heap);
+
+	backing = calloc(1, sizeof(*backing));
+	if (!backing) {
+		close(alloc.fd);
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+	}
+	for (unsigned int i = 0; i < VIDEO_MAX_PLANES; i++)
+		backing->dmabuf_fd[i] = -1;
+
+	backing->pixelformat = V4L2_PIX_FMT_NV12;
+	backing->width = width;
+	backing->height = height;
+	backing->pitch = pitch;
+	backing->nb_planes = 1;
+	backing->plane_size[0] = alloc.len;
+	backing->dmabuf_fd[0] = alloc.fd;
+
+	surface->backing = backing;
+	return VA_STATUS_SUCCESS;
+}
