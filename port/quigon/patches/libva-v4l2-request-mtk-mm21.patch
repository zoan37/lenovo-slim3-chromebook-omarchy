+/*
+ * MediaTek MM21 (mtk-vcodec-dec): there is no mem2mem device that reads it
+ * (no MDP on the ChromeOS kernel), so frames are detiled on the CPU right
+ * when their decode completes. MM21 stores each plane as a raster of tiles
+ * 16 bytes wide and 32 rows tall for luma, 16 rows for the interleaved
+ * chroma; each tile is one contiguous block (16 * tile_height bytes), and a
+ * row of tiles takes bytesperline * tile_height bytes.
+ *
+ * The source is read strictly sequentially, a whole tile at a time in
+ * 64-byte loads, and the rows are scattered into the destination. With the
+ * CAPTURE buffers allocated non-coherent (cached, see context.c) a 1080p
+ * frame takes ~1.7 ms on the Kompanio 540 (~4 ms from the default uncached
+ * mapping).
+ */
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+
+static void detile_plane(const uint8_t *src, uint32_t src_stride,
+			 uint8_t *dst, uint32_t dst_stride,
+			 uint32_t width, uint32_t height, uint32_t tile_height)
+{
+	const size_t tile_size = 16 * tile_height;
+
+	for (uint32_t y0 = 0; y0 < height; y0 += tile_height) {
+		const uint8_t *tile = src + (size_t)(y0 / tile_height) * src_stride * tile_height;
+		uint32_t rows = height - y0 < tile_height ? height - y0 : tile_height;
+		uint8_t *drow = dst + (size_t)y0 * dst_stride;
+
+		for (uint32_t x = 0; x < width; x += 16, tile += tile_size) {
+			const uint8_t *s = tile;
+			uint8_t *d = drow + x;
+			uint32_t r = 0;
+
+#if defined(__aarch64__)
+			for (; r + 4 <= rows; r += 4, s += 64, d += 4 * (size_t)dst_stride) {
+				uint8x16x4_t v = vld1q_u8_x4(s);
+
+				vst1q_u8(d, v.val[0]);
+				vst1q_u8(d + dst_stride, v.val[1]);
+				vst1q_u8(d + 2 * (size_t)dst_stride, v.val[2]);
+				vst1q_u8(d + 3 * (size_t)dst_stride, v.val[3]);
+			}
+#endif
+			for (; r < rows; r++, s += 16, d += dst_stride)
+				memcpy(d, s, 16);
+		}
+	}
+}
+
+/*
+ * Detile in horizontal bands of whole tile rows on several threads: a 4K MM21
+ * frame takes ~8.5 ms on one core, too much for a 60 fps decode thread that
+ * also waits on the decoder (Chrome dropped frames at 4K60). The caller takes
+ * the first band; a band whose thread can't be started runs inline.
+ */
+#define DETILE_THREADS 4
+
+struct detile_band {
+	const uint8_t *src;
+	uint32_t src_stride;
+	uint8_t *dst;
+	uint32_t dst_stride;
+	uint32_t width, height, tile_height;
+};
+
+static void *detile_band_run(void *arg)
+{
+	struct detile_band *b = arg;
+
+	detile_plane(b->src, b->src_stride, b->dst, b->dst_stride, b->width,
+		     b->height, b->tile_height);
+	return NULL;
+}
+
+static void detile_plane_mt(const uint8_t *src, uint32_t src_stride,
+			    uint8_t *dst, uint32_t dst_stride,
+			    uint32_t width, uint32_t height, uint32_t tile_height)
+{
+	uint32_t tile_rows = (height + tile_height - 1) / tile_height;
+	uint32_t per = (tile_rows + DETILE_THREADS - 1) / DETILE_THREADS;
+	struct detile_band bands[DETILE_THREADS];
+	pthread_t threads[DETILE_THREADS];
+	bool started[DETILE_THREADS] = { false };
+	unsigned int n = 0;
+
+	if (tile_rows < 2 * DETILE_THREADS) {
+		detile_plane(src, src_stride, dst, dst_stride, width, height,
+			     tile_height);
+		return;
+	}
+
+	for (uint32_t r0 = 0; r0 < tile_rows && n < DETILE_THREADS; r0 += per, n++) {
+		uint32_t y0 = r0 * tile_height;
+		uint32_t y1 = (r0 + per) * tile_height;
+
+		bands[n] = (struct detile_band) {
+			.src = src + (size_t)r0 * src_stride * tile_height,
+			.src_stride = src_stride,
+			.dst = dst + (size_t)y0 * dst_stride,
+			.dst_stride = dst_stride,
+			.width = width,
+			.height = (y1 < height ? y1 : height) - y0,
+			.tile_height = tile_height,
+		};
+	}
+	for (unsigned int i = 1; i < n; i++)
+		started[i] = pthread_create(&threads[i], NULL, detile_band_run,
+					    &bands[i]) == 0;
+	detile_band_run(&bands[0]);
+	for (unsigned int i = 1; i < n; i++) {
+		if (started[i])
+			pthread_join(threads[i], NULL);
+		else
+			detile_band_run(&bands[i]);
+	}
+}
+
+static VAStatus convert_setup_cpu(struct v4l2r_context *ctx)
+{
+	struct v4l2r_convert *conv;
+	struct v4l2_pix_format_mplane *pix_mp;
+	uint32_t width = v4l2r_format_width(&ctx->capture_format);
+	uint32_t height = v4l2r_format_height(&ctx->capture_format);
+	uint32_t pitch = (width + 63) & ~63u;
+
+	if (!V4L2_TYPE_IS_MULTIPLANAR(ctx->capture_format.type) ||
+	    width % 16 || height % 32)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	conv = calloc(1, sizeof(*conv));
+	if (!conv)
+		return VA_STATUS_ERROR_ALLOCATION_FAILED;
+
+	conv->fd = -1;
+	conv->cpu = true;
+	conv->output_format = ctx->capture_format;
+	conv->capture_format = (struct v4l2_format) {
+		.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+	};
+	pix_mp = &conv->capture_format.fmt.pix_mp;
+	pix_mp->pixelformat = V4L2_PIX_FMT_NV12;
+	pix_mp->width = width;
+	pix_mp->height = height;
+	pix_mp->num_planes = 1;
+	pix_mp->plane_fmt[0].bytesperline = pitch;
+	pix_mp->plane_fmt[0].sizeimage = pitch * height * 3 / 2;
+
+	for (unsigned int i = 0; i < V4L2R_CONVERT_SLOTS; i++)
+		conv->jobs[i].capture_index = -1;
+
+	ctx->conv = conv;
+	v4l2r_log("converting MM21 to NV12 on the CPU (%ux%u)\n", width, height);
+
+	return VA_STATUS_SUCCESS;
+}
+
+static void dmabuf_sync(int fd, uint64_t flags)
+{
+	struct dma_buf_sync sync = { .flags = flags };
+
+	if (fd >= 0)
+		ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+}
+
+/* Detile a finished MM21 decode into the surface's NV12 backing. Called with
+ * ctx->mutex held, from the CAPTURE dequeue path. */
+static void convert_cpu(struct v4l2r_context *ctx,
+			struct v4l2r_capture_buffer *capture, int capture_index,
+			struct v4l2r_surface *surface)
+{
+	struct v4l2r_convert *conv = ctx->conv;
+	const struct v4l2_pix_format_mplane *src = &ctx->capture_format.fmt.pix_mp;
+	uint32_t width = src->width, height = src->height;
+	uint32_t y_stride = src->plane_fmt[0].bytesperline;
+	uint32_t uv_stride = src->num_planes > 1 ?
+			     src->plane_fmt[1].bytesperline : y_stride;
+	struct v4l2r_surface_backing *backing;
+	const uint8_t *y, *uv;
+	uint8_t *dst;
+	uint64_t t0 = v4l2r_now_ns();
+
+	if (v4l2r_surface_convert_backing(ctx->drv, surface) != VA_STATUS_SUCCESS) {
+		v4l2r_log("no NV12 backing for MM21 conversion\n");
+		conv->failed = true;
+		return;
+	}
+	backing = surface->backing;
+
+	/* The GPU first (convert_gl.c), the CPU if that isn't available. */
+	if (backing->dmabuf_fd[0] >= 0 &&
+	    v4l2r_export_capture_dmabufs(ctx, capture, capture_index) == 0) {
+		uint32_t w = width, h = height;
+		struct v4l2r_gl_plane py, puv;
+
+		if (w > backing->width)
+			w = backing->width;
+		if (w > backing->pitch)
+			w = backing->pitch & ~15u;
+		if (h > backing->height)
+			h = backing->height;
+		py = (struct v4l2r_gl_plane) { capture->dmabuf_fd[0], 0, y_stride,
+					       capture->plane_size[0] / y_stride };
+		if (capture->nb_planes > 1)
+			puv = (struct v4l2r_gl_plane) { capture->dmabuf_fd[1], 0, uv_stride,
+							capture->plane_size[1] / uv_stride };
+		else
+			puv = (struct v4l2r_gl_plane) { capture->dmabuf_fd[0], y_stride * height, uv_stride,
+							(capture->plane_size[0] - y_stride * height) / uv_stride };
+		if (v4l2r_gl_detile(&py, &puv, backing->dmabuf_fd[0], backing->pitch,
+				    backing->pitch * backing->height, w & ~15u, h)) {
+			v4l2r_trace("MM21 GPU detile (surface 0x%08x buf #%d): %.2f ms\n",
+				    surface->id, capture_index, (v4l2r_now_ns() - t0) / 1e6);
+			return;
+		}
+	}
+
+	for (unsigned int i = 0; i < capture->nb_planes; i++) {
+		if (capture->map[i])
+			continue;
+		capture->map[i] = mmap(NULL, capture->plane_size[i], PROT_READ,
+				       MAP_SHARED, ctx->video_fd,
+				       capture->plane_mem_offset[i]);
+		if (capture->map[i] == MAP_FAILED) {
+			capture->map[i] = NULL;
+			v4l2r_log("cannot map CAPTURE buffer %d plane %u: %s\n",
+				  capture_index, i, strerror(errno));
+			conv->failed = true;
+			return;
+		}
+	}
+	if (!backing->map[0]) {
+		void *addr = mmap(NULL, backing->plane_size[0],
+				  PROT_READ | PROT_WRITE, MAP_SHARED,
+				  backing->dmabuf_fd[0], 0);
+		if (addr == MAP_FAILED) {
+			v4l2r_log("cannot map NV12 backing: %s\n", strerror(errno));
+			conv->failed = true;
+			return;
+		}
+		backing->map[0] = addr;
+	}
+
+	y = capture->map[0];
+	uv = capture->nb_planes > 1 ? capture->map[1] :
+	     y + (size_t)y_stride * height;
+	dst = backing->map[0];
+
+	if (v4l2r_export_capture_dmabufs(ctx, capture, capture_index) == 0)
+		for (unsigned int i = 0; i < capture->nb_planes; i++)
+			dmabuf_sync(capture->dmabuf_fd[i],
+				    DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+	dmabuf_sync(backing->dmabuf_fd[0], DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE);
+
+	/* The backing may be smaller than the decoder's aligned CAPTURE
+	 * frame (1920x1080 exported vs 1920x1088 decoded): clamp, and place
+	 * chroma where the exported layout says (pitch * backing height). */
+	if (width > backing->width)
+		width = backing->width;
+	if (width > backing->pitch)
+		width = backing->pitch & ~15u;
+	detile_plane_mt(y, y_stride, dst, backing->pitch, width,
+		     height < backing->height ? height : backing->height, 32);
+	detile_plane_mt(uv, uv_stride, dst + (size_t)backing->pitch * backing->height,
+		     backing->pitch, width,
+		     (height < backing->height ? height : backing->height) / 2, 16);
+
+	dmabuf_sync(backing->dmabuf_fd[0], DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE);
+	for (unsigned int i = 0; i < capture->nb_planes; i++)
+		dmabuf_sync(capture->dmabuf_fd[i],
+			    DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+
+	v4l2r_trace("MM21 detile (surface 0x%08x buf #%d): %.2f ms\n",
+		    surface->id, capture_index, (v4l2r_now_ns() - t0) / 1e6);
+}
