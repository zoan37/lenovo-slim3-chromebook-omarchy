+static int mt8189_scp_clk_get(struct mtk_scp *scp)
+{
+	struct clk *clk;
+
+	/*
+	 * The SCP core runs from vlp_scp_sel: keep it enabled for as long as
+	 * the driver is bound, so that neither clk_disable_unused() nor the
+	 * clk_disable() calls of this driver stop a running SCP.
+	 */
+	clk = devm_clk_get_optional_enabled(scp->dev, "main");
+	if (IS_ERR(clk))
+		return dev_err_probe(scp->dev, PTR_ERR(clk), "Failed to get clock\n");
+
+	scp->clk = NULL;
+
+	return 0;
+}
