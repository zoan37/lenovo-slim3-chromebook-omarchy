From b10d21e66984e54b3e816146f7e5e18c890892e8 Mon Sep 17 00:00:00 2001
From: quigon <quigon@localhost>
Date: Sat, 10 Oct 2026 14:08:58 -0400
Subject: [PATCH] drm/mediatek: USB-C DP and external CRTC fixes from review

- mtk_dp_v2: no PM notifier (it powered the DP TX off before mediatek-drm disabled the pipe); resume re-links a
  sink that stayed plugged in over the sleep (no HPD edge follows the port reset); NULL-guard the connector in
  disconnect_release; drop dead !mtk_dp branches that dereferenced it.
- mtk_crtc: recompute the output slot on every enable, not only on connectors_changed; refuse hw_init with an
  empty slot; skip it in destroy.
- mtk-mutex: MT8189 COLOR1 is mod 7, not 4 (RDMA0).
---
 drivers/gpu/drm/mediatek/mtk_crtc.c  |  17 +++-
 drivers/gpu/drm/mediatek/mtk_dp_v2.c | 140 +++++++++++++--------------
 drivers/soc/mediatek/mtk-mutex.c     |   2 +-
 3 files changed, 83 insertions(+), 76 deletions(-)

diff --git a/drivers/gpu/drm/mediatek/mtk_crtc.c b/drivers/gpu/drm/mediatek/mtk_crtc.c
index cef37c184..25653c283 100644
--- a/drivers/gpu/drm/mediatek/mtk_crtc.c
+++ b/drivers/gpu/drm/mediatek/mtk_crtc.c
@@ -146,7 +146,8 @@ static void mtk_crtc_destroy(struct drm_crtc *crtc)
 		struct mtk_ddp_comp *comp;
 
 		comp = mtk_crtc->ddp_comp[i];
-		mtk_ddp_comp_unregister_vblank_cb(comp);
+		if (comp)	/* the output slot stays empty until the CRTC was first enabled */
+			mtk_ddp_comp_unregister_vblank_cb(comp);
 	}
 
 	drm_crtc_cleanup(crtc);
@@ -352,6 +353,13 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 	if (WARN_ON(!crtc->state))
 		return -EINVAL;
 
+	/* a CRTC with connector routes has no output until one of them matched the encoder in use */
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++)
+		if (!mtk_crtc->ddp_comp[i]) {
+			drm_err(dev, "crtc %d has no output for its encoder\n", drm_crtc_index(crtc));
+			return -EINVAL;
+		}
+
 	width = crtc->state->adjusted_mode.hdisplay;
 	height = crtc->state->adjusted_mode.vdisplay;
 	vrefresh = drm_mode_vrefresh(&crtc->state->adjusted_mode);
@@ -694,9 +702,10 @@ static void mtk_crtc_update_output(struct drm_crtc *crtc,
 	struct mtk_drm_private *priv;
 	unsigned int encoder_mask = crtc_state->encoder_mask;
 
-	if (!crtc_state->connectors_changed)
-		return;
-
+	/*
+	 * Recompute on every enable, not only when connectors_changed: a CRTC turned off (DPMS) while its connector
+	 * was swapped for another comes back with only active_changed, and kept the old output in its last slot.
+	 */
 	if (!mtk_crtc->num_conn_routes)
 		return;
 
diff --git a/drivers/gpu/drm/mediatek/mtk_dp_v2.c b/drivers/gpu/drm/mediatek/mtk_dp_v2.c
index 4ab946e16..abe2700fd 100644
--- a/drivers/gpu/drm/mediatek/mtk_dp_v2.c
+++ b/drivers/gpu/drm/mediatek/mtk_dp_v2.c
@@ -4298,17 +4298,21 @@ static void mtk_dp_disconnect_release_v2(struct mtk_dp *mtk_dp)
 		mtk_dp_video_mute_v2(mtk_dp, DP_SST_ENCODER_PORT, true);
 		mtk_dp_audio_mute_v2(mtk_dp, DP_SST_ENCODER_PORT, true);
 		mtk_dp_video_disable_v2(mtk_dp, DP_SST_ENCODER_PORT);
-		mtk_dp->mtk_con[DP_FIRST_CON]->video_enable = false;
+		if (mtk_dp->mtk_con[DP_FIRST_CON])
