+static bool keep_power_on_hang = true;
+module_param(keep_power_on_hang, bool, 0644);
+MODULE_PARM_DESC(keep_power_on_hang,
+		 "After a decode timeout, leave the decoder powered and refuse further decoding instead of gating a possibly busy engine");
+
+/*
+ * After a timeout the firmware has already run its DEC_END cleanup, which can
+ * leave the core in a state where any register access faults: only log state
+ * that lives outside the decoder.
+ */
+static void mtk_vcodec_dec_dump_hang(struct mtk_vcodec_dec_dev *vdec_dev, int hw_idx)
+{
+	struct mtk_vdec_hw_dev *hw;
+
+	if (vdec_dev->vdec_pdata->is_subdev_supported) {
+		hw = mtk_vcodec_get_hw_dev(vdec_dev, hw_idx);
+		if (hw)
+			dev_err(&vdec_dev->plat_dev->dev, "hw %d hang: handler ran %d times, last status 0x%08x\n",
+				hw_idx, atomic_read(&hw->irq_cnt), hw->irq_last_status);
+	}
+	mtk_vcodec_dec_dump_scp_printf(vdec_dev, "after DEC_END");
+}
