+/*
+ * Decode-timeout diagnostics. scp_printf_da: SCP-side address of the
+ * firmware's printf buffer (its last formatted log line), 0 = off; for the
+ * MT8189 scp.img "e3c0782" that is 0x2ca8c (SRAM symbol printf_buf).
+ * vdec_timeout_dump_regs: also read the decoder status registers at timeout.
+ */
+static unsigned int scp_printf_da;
+module_param(scp_printf_da, uint, 0644);
+MODULE_PARM_DESC(scp_printf_da, "SCP address of the firmware printf buffer to log on decode timeout (0 = off)");
+
+static bool vdec_timeout_dump_regs;
+module_param(vdec_timeout_dump_regs, bool, 0644);
+MODULE_PARM_DESC(vdec_timeout_dump_regs, "Read decoder status registers on decode timeout (may fault)");
+
+void mtk_vcodec_dec_dump_scp_printf(struct mtk_vcodec_dec_dev *vdec_dev, const char *when)
+{
+	char buf[257];
+	void *va;
+	int i;
+
+	if (!scp_printf_da || !vdec_dev->fw_handler)
+		return;
+
+	va = mtk_vcodec_fw_map_dm_addr(vdec_dev->fw_handler, scp_printf_da);
+	if (IS_ERR_OR_NULL(va))
+		return;
+
+	/* SCP SRAM: always accessible while the SCP runs */
+	memcpy_fromio(buf, (void __iomem *)va, 256);
+	buf[256] = 0;
+	for (i = 0; i < 256 && buf[i]; i++)
+		if (!isprint(buf[i]))
+			buf[i] = '.';
+	dev_err(&vdec_dev->plat_dev->dev, "scp printf_buf (%s): %s\n", when, buf);
+}
+EXPORT_SYMBOL_GPL(mtk_vcodec_dec_dump_scp_printf);
+
+/* still inside the decode: power, clocks and irq are on, firmware not told yet */
+static void mtk_vcodec_dec_timeout_dump(struct mtk_vcodec_dec_ctx *ctx, unsigned int hw_id)
+{
+	struct mtk_vcodec_dec_dev *vdec_dev = ctx->dev;
+	struct device *dev = &vdec_dev->plat_dev->dev;
+	struct mtk_vdec_hw_dev *hw = NULL;
+	struct irq_data *d;
+	bool pending = false;
+
+	if (vdec_dev->vdec_pdata->is_subdev_supported && hw_id < MTK_VDEC_HW_MAX)
+		hw = vdec_dev->subdev_dev[hw_id];
+
+	if (hw) {
+		irq_get_irqchip_state(hw->dec_irq, IRQCHIP_STATE_PENDING, &pending);
+		d = irq_get_irq_data(hw->dec_irq);
+		dev_err(dev, "timeout hw %u: irq %d (hwirq %lu) %s, handler ran %d times, last status 0x%08x\n",
+			hw_id, hw->dec_irq, d ? d->hwirq : 0, pending ? "PENDING" : "not pending",
+			atomic_read(&hw->irq_cnt), hw->irq_last_status);
+		if (vdec_timeout_dump_regs)
+			dev_err(dev, "timeout hw %u: misc+0x%x = 0x%08x, sys+0 = 0x%08x\n",
+				hw_id, VDEC_IRQ_CFG_REG,
+				readl(hw->reg_base[VDEC_HW_MISC] + VDEC_IRQ_CFG_REG),
+				readl(hw->reg_base[VDEC_HW_SYS] + VDEC_HW_ACTIVE_ADDR));
+	}
+
+	mtk_vcodec_dec_dump_scp_printf(vdec_dev, "at timeout");
+}
