+/* PAN_RO_VERTEX_SSBO: vertex shaders may only read SSBOs. IDVS runs the
+ * position and varying parts of a vertex shader separately and may shade a
+ * vertex more than once, and transform feedback runs a second copy of the
+ * shader, so writes and atomics would be repeated. Drop them (atomics return
+ * 0) and warn once rather than let them reach the hardware.
+ */
+static bool
+panfrost_drop_vs_ssbo_write(nir_builder *b, nir_intrinsic_instr *intr,
+                            void *data)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_store_ssbo:
+   case nir_intrinsic_ssbo_atomic:
+   case nir_intrinsic_ssbo_atomic_swap:
+      break;
+   default:
+      return false;
+   }
+
+   if (nir_intrinsic_infos[intr->intrinsic].has_dest) {
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def, nir_imm_zero(b, intr->def.num_components,
+                                               intr->def.bit_size));
+   } else {
+      nir_instr_remove(&intr->instr);
+   }
+
+   return true;
+}
+
+static void
+panfrost_make_vs_ssbo_read_only(nir_shader *nir)
+{
+   bool progress = false;
+
+   NIR_PASS(progress, nir, nir_shader_intrinsics_pass,
+            panfrost_drop_vs_ssbo_write, nir_metadata_control_flow, NULL);
+
+   if (progress) {
+      static bool warned = false;
+      if (!warned) {
+         mesa_logw("panfrost: PAN_RO_VERTEX_SSBO: vertex shader SSBO writes "
+                   "and atomics are not supported and were dropped");
+         warned = true;
+      }
+      nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+   }
+}
+
 static void *
 panfrost_create_shader_state(struct pipe_context *pctx,
                              const struct pipe_shader_state *cso)
@@ -506,6 +555,11 @@ panfrost_create_shader_state(struct pipe_context *pctx,
                         ? tgsi_to_nir(cso->tokens, pctx->screen, false)
                         : cso->ir.nir;
 
+   /* Before panfrost_alloc_shader(), so its cache key covers the result. */
+   if (nir->info.stage == MESA_SHADER_VERTEX &&
+       pan_screen(pctx->screen)->ro_vertex_ssbo)
+      panfrost_make_vs_ssbo_read_only(nir);
+
    struct panfrost_uncompiled_shader *so = panfrost_alloc_shader(nir);
 
