       bool allow_side_effects = (i != MESA_SHADER_VERTEX);
 
+      /* Reading memory from the vertex stage is fine with IDVS (the position
+       * and varying shaders may both read, and reads have no observable
+       * effect), so with PAN_RO_VERTEX_SSBO=1 vertex shaders get SSBOs too.
+       * Vertex shader SSBO writes and atomics are removed at CSO creation, so
+       * the hardware still never sees vertex-stage side effects. Images stay
+       * disabled.
+       */
+      bool allow_vertex_ssbo = i == MESA_SHADER_VERTEX &&
+                               screen->ro_vertex_ssbo && dev->arch >= 6;
+
