# Compositor-only environment (wayland-wm@hyprland.desktop.service drop-in). Its presence also switches the session
# launcher (apps -> Zink) and quigon-chrome (Chrome -> libmali) to GPU mode. Rename it to fall back to llvmpipe.
LD_LIBRARY_PATH=/opt/quigon-gpu/mali/lib
LD_PRELOAD=/opt/quigon-gpu/lib/egl-mali-shim.so
HYPRLAND_EGL_NO_MODIFIERS=1
# Aquamarine allocates scanout buffers through Mesa GBM: keep that on kms_swrast dumb buffers
# (Zink's exportable images fail on the Mali: VK_ERROR_INVALID_EXTERNAL_HANDLE).
GBM_ALWAYS_SOFTWARE=1
QUIGON_EGL_SHIM_TRACE=1
# Hyprland's children (the Omarchy bar, exec-once apps) inherit this file's environment. Hyprland itself renders through
# libmali (ignores these); Mesa clients started by it must use llvmpipe, or Mesa picks the mediatek display node as a GPU
# and crashes in dri2_query_image (seen with Quickshell).
LIBGL_ALWAYS_SOFTWARE=1
GALLIUM_DRIVER=llvmpipe
