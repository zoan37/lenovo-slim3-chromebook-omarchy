# Compositor-unit environment (wayland-wm@hyprland.desktop.service drop-in). Hyprland passes it on to everything it
# starts, i.e. every app launched from the desktop. Its presence also puts the session launcher, quigon-chrome,
# quigon-electron and quigon-ghostty in GPU mode. Rename it to fall back to llvmpipe everywhere.
# Hyprland itself: ChromeOS's libmali through the EGL shim (cleared for its children by the shim).
LD_LIBRARY_PATH=/opt/quigon-gpu/mali/lib
LD_PRELOAD=/opt/quigon-gpu/lib/egl-mali-shim.so
HYPRLAND_EGL_NO_MODIFIERS=1
QUIGON_EGL_SHIM_TRACE=1
# Aquamarine's scanout buffers: Mesa GBM on kms_swrast dumb buffers (Zink can't export images on the Mali).
GBM_ALWAYS_SOFTWARE=1
# Apps: Mesa OpenGL on the Mali through Zink. Exceptions: the Omarchy bar (omarchy-launch-shell is patched to run
# Quickshell on llvmpipe), anything run with quigon-nozink.
MESA_LOADER_DRIVER_OVERRIDE=zink
# SDL games default to X11 when DISPLAY is set; Zink under Xwayland crashes (DRI3 needs image export).
SDL_VIDEODRIVER=wayland,x11
