#!/bin/sh
# quigon, mainline kernel only: switch the panel off through the compositor before system sleep and back on after.
# The kernel's own suspend-time display shutdown (mediatek-drm's drm_mode_config_helper_suspend in .prepare) waits on
# flip_done events that never arrive and takes 30 s; with the CRTC already off through Hyprland (the same path as idle
# DPMS, which works) it has nothing to do. systemd-sleep runs this with "pre"/"post" while userspace still runs.
case "$(uname -r)" in *-quigon*) ;; *) exit 0 ;; esac
case "$1" in pre) action=disable ;; post) action=enable ;; *) exit 0 ;; esac
for s in /run/user/*/hypr/*/.socket.sock; do
  [ -S "$s" ] || continue
  d=${s%/.socket.sock}; sig=${d##*/}; uid=$(echo "$s" | cut -d/ -f4)
  runuser -u "$(id -nu "$uid")" -- env XDG_RUNTIME_DIR=/run/user/$uid HYPRLAND_INSTANCE_SIGNATURE=$sig \
    hyprctl dispatch "hl.dsp.dpms({ action = \"$action\" })" >/dev/null 2>&1
done
[ "$action" = disable ] && sleep 1
exit 0
