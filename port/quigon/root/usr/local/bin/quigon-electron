#!/bin/bash
# Run an Electron/Chromium app on the Mali-G57 the way quigon-chrome runs Chrome: ANGLE GLES on ChromeOS's libmali
# (egl-mali-shim as libEGL.so.1) + ChromeOS minigbm, from /opt/quigon-gpu/chrome-lib, and adds
# --use-gl=angle --use-angle=gles after the program name. Apps that turn hardware acceleration off themselves still
# need their own setting switched on (Grok Bot does this). quigon-electron-sync points every installed Electron app
# here automatically. Usage: quigon-electron <launcher> [args...]. No-op without /etc/quigon/gpu.env.
if [[ -n $QUIGON_ELECTRON ]] || [[ ! -f /etc/quigon/gpu.env || ! -e /opt/quigon-gpu/chrome-lib/libEGL.so.1 ]]; then
  exec "$@"
fi
export QUIGON_ELECTRON=1
export LD_LIBRARY_PATH=/opt/quigon-gpu/chrome-lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export QUIGON_EGL_SHIM_EXE=none
unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER GBM_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE
args=("$@"); i=0
# "env VAR=x app ...": the flags go after app, not after env.
if [[ ${args[0]##*/} == env ]]; then i=1; while [[ ${args[i]} == *=* || ${args[i]} == -* ]]; do ((i++)); done; fi
exec "${args[@]:0:i+1}" --use-gl=angle --use-angle=gles "${args[@]:i+1}"
