#!/bin/bash
# Keep the Omarchy bar (Quickshell) off Mesa while desktop apps default to Zink: the real Omarchy shell crashes on Zink
# here (vkCreateImage VK_ERROR_INVALID_EXTERNAL_HANDLE). QT_QUICK_BACKEND=software makes its Qt Quick scene render
# without OpenGL, so it never loads Mesa, while its environment still carries Zink for the apps it launches (the
# Omarchy launcher/menus run inside the bar). Idempotent; re-applied by zz-omarchy-launch-shell.hook after upgrades.
f=/usr/bin/omarchy-launch-shell
[[ -f $f ]] || exit 0
sed -i 's|-- env -u MESA_LOADER_DRIVER_OVERRIDE LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe quickshell|-- env QT_QUICK_BACKEND=software quickshell|' "$f"
grep -q 'env QT_QUICK_BACKEND=software quickshell' "$f" || \
  sed -i 's|systemd-cat -t omarchy-shell -- quickshell -n -p|systemd-cat -t omarchy-shell -- env QT_QUICK_BACKEND=software quickshell -n -p|' "$f"
grep -q 'quigon: bar' "$f" || sed -i '0,/^run_shell() {/s//# quigon: bar renders Qt Quick in software (see \/usr\/local\/bin\/fix-omarchy-launch-shell)\nrun_shell() {/' "$f"
sed -i 's|^# quigon: bar on llvmpipe (see /usr/local/bin/fix-omarchy-launch-shell)|# quigon: bar renders Qt Quick in software (see /usr/local/bin/fix-omarchy-launch-shell)|' "$f"
