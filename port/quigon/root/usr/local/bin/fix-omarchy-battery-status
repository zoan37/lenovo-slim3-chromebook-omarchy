#!/bin/bash
# Make omarchy-battery-status (the bar's power panel) find non-x86 batteries. Stock matches only "BAT" (BAT0 on x86), so
# on this Chromebook (UPower .../battery_sbs_10_000b, smart-battery "sbs-10-000b") the panel shows no %, W, Wh or time.
# Also reads cycles/thresholds from the found battery instead of BAT*, and takes |power| (sbs reports current_now
# negative while discharging and has no power_now; qcom-battmgr reports power_now negative). Based on the Zenbook A16 fix
# in omarchy-setup. Idempotent; re-applied by zz-omarchy-battery-status.hook after omarchy upgrades.
# Upstream: omacom/omarchy#13029 (non-BAT battery lookup) + #13111 (magnitude of negative rates) cover this; tested both on
# this device (comments on both PRs, 2026-10-09). Drop this patch and its hook once both are in an omarchy release.
f=/usr/bin/omarchy-battery-status
[[ -f $f ]] || exit 0
sed -i \
  -e "s/grep BAT | head -n 1/grep -E 'BAT|_bat\$|\/battery_' | head -n 1/" \
  -e 's|"\$power_supply_path"/BAT\*/|"$battery_path"/|g' \
  -e 's|BEGIN { print microwatts / 1000000 }|BEGIN { w = microwatts / 1000000; print (w < 0 ? -w : w) }|' \
  -e 's|BEGIN { print microamps \* microvolts / 1000000000000 }|BEGIN { w = microamps * microvolts / 1000000000000; print (w < 0 ? -w : w) }|' \
  "$f"
