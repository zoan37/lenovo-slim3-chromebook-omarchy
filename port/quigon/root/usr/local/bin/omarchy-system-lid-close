#!/bin/bash
# quigon: Omarchy's lid-close (lock + clamshell), then switch the laptop panel off when nothing else is showing the
# desktop: covers a lid close on the charger, where logind doesn't suspend (40-quigon-lid-ac.conf), under both kernels.
# Run by quigon-lid-watch (Hyprland's lid bindings don't fire here); omarchy-hyprland-monitor-clamshell, run on lid
# open, switches the panel back on.
logger -t quigon-lid "lid-close ($*)"
o=/usr/share/omarchy/bin/omarchy-system-lid-close; [[ -x $o ]] || o=/usr/bin/omarchy-system-lid-close
"$o" "$@"
if omarchy-hw-laptop-closed && ! omarchy-hw-external-monitors; then
  panel=$(omarchy-hyprland-monitor-laptop)
  if [[ $panel =~ ^[A-Za-z0-9._-]+$ ]]; then
    touch "${XDG_RUNTIME_DIR:-/tmp}/quigon-lid-blanked"
    hyprctl dispatch "hl.dsp.dpms({ action = \"disable\", monitor = \"$panel\" })" >/dev/null 2>&1 || true
  fi
fi
