#!/bin/bash
# Run at login (autostart.lua): say so when this boot isn't the default mainline kernel: the ChromeOS-kernel fallback,
# or a rollback to the previous mainline kernel. quigon-kernel (via boot-good) leaves the reason in
# /run/quigon/kernel-notice; login can come before boot-good, so wait for it a little.
for _ in $(seq 60); do [[ -e /run/quigon/boot-good.done ]] && break; sleep 1; done
n=/run/quigon/kernel-notice
if [[ -r $n ]]; then
  IFS='|' read -r urgency title body < "$n"
elif [[ $(uname -r) != *-quigon* ]]; then
  urgency=normal title="Running the ChromeOS kernel (fallback)" body="Not the mainline kernel. 'quigon-kernel status' shows the boot slots."
elif [[ -n ${QUIGON_KERNEL_NOTIFY_TEST:-} ]]; then
  urgency=normal title="Mainline kernel" body="$(uname -r) (test notification)"
else
  exit 0
fi
# autostart runs before the shell serves notifications: wait for it, or the notification is lost
omarchy-notification-wait 60 >/dev/null 2>&1 || true
notify-send -u "$urgency" -a "Kernel" "$title" "$body"
