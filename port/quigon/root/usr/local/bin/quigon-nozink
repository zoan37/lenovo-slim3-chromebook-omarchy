#!/bin/bash
# Run one app on Mesa's CPU renderer (llvmpipe) instead of the session default (Zink on the Mali), for apps that break
# on Zink. Usage: quigon-nozink <command> [args...]
unset MESA_LOADER_DRIVER_OVERRIDE
export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe GBM_ALWAYS_SOFTWARE=1
exec "$@"
