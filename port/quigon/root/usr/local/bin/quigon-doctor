#!/bin/bash
# quigon-doctor — check (and repair where safe) everything custom on this Chromebook port after updates.
#   quigon-doctor               full check (run as the desktop user or root; repairs need root)
#   quigon-doctor --fix         full check, repairing what it can
#   quigon-doctor --post-update quick non-session checks + repairs, notify on problems (pacman hook)
#   quigon-doctor --guard-pacman restore pacman.conf/mirrorlist if they lost Arch Linux ARM (path unit)
set -u
MODE=${1:-check}
FIX=0; [[ $MODE == --fix || $MODE == --post-update || $MODE == --guard-pacman ]] && FIX=1
(( EUID == 0 )) || FIX=0
ok=0; bad=0; fixed=0; problems=()
pass() { echo "  ✓ $*"; ok=$((ok+1)); }
fail() { echo "  ✗ $*"; bad=$((bad+1)); problems+=("$*"); }
repaired() { echo "  ↻ $*"; fixed=$((fixed+1)); }
section() { echo; echo "$*"; }
desk_user() { local u; u=$(systemctl list-units --no-legend 'quigon-desktop@*.service' 2>/dev/null | sed -n 's/.*quigon-desktop@\([^.]*\)\.service.*/\1/p' | head -1); echo "${u:-$(id -nu 1001 2>/dev/null)}"; }
notify_user() {
  local title=$1 body=$2 u uid
  u=$(desk_user); uid=$(id -u "$u" 2>/dev/null) || return 0
  [[ -S /run/user/$uid/bus ]] || return 0
  if (( EUID == 0 )); then
    runuser -u "$u" -- env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus notify-send -u critical -a "quigon-doctor" "$title" "$body" 2>/dev/null
  else
    notify-send -u critical -a "quigon-doctor" "$title" "$body" 2>/dev/null
  fi
}

check_pacman() {
  section "Package config"
  local good=/etc/quigon/pacman.conf.good goodm=/etc/quigon/mirrorlist.good
  if grep -q '^\[alarm\]' /etc/pacman.conf && grep -q '^\[omarchy\]' /etc/pacman.conf && grep -q 'pkgs.omarchy.org/edge' /etc/pacman.conf; then
    pass "pacman.conf has Arch Linux ARM + Omarchy edge repos"
  elif (( FIX )) && [[ -f $good ]]; then
    cp -f /etc/pacman.conf "/etc/quigon/pacman.conf.replaced-$(date +%Y%m%d%H%M%S)"; cp -f "$good" /etc/pacman.conf
    repaired "pacman.conf lost the Arch Linux ARM repos; restored the known-good copy (replaced one saved in /etc/quigon)"
    notify_user "Package config restored" "Something replaced /etc/pacman.conf without the Arch Linux ARM repos (likely an Omarchy x86 refresh). The working copy was restored."
  else
    fail "pacman.conf lacks [alarm]/[omarchy] edge (restore: sudo cp $good /etc/pacman.conf)"
  fi
  if grep -q 'archlinuxarm.org' /etc/pacman.d/mirrorlist; then
    pass "mirrorlist points at Arch Linux ARM"
  elif (( FIX )) && [[ -f $goodm ]]; then
    cp -f /etc/pacman.d/mirrorlist "/etc/quigon/mirrorlist.replaced-$(date +%Y%m%d%H%M%S)"; cp -f "$goodm" /etc/pacman.d/mirrorlist
    repaired "mirrorlist restored to Arch Linux ARM"
    notify_user "Mirror list restored" "Something replaced /etc/pacman.d/mirrorlist with non-ARM mirrors. The working copy was restored."
  else
    fail "mirrorlist has no archlinuxarm.org mirror (restore: sudo cp $goodm /etc/pacman.d/mirrorlist)"
  fi
}

check_system() {
  section "Boot and kernel"
  local kver; kver=$(uname -r)
  [[ -d /usr/lib/modules/$kver ]] && pass "modules for running kernel $kver present" || fail "no /usr/lib/modules/$kver (ChromeOS modules missing)"
  if [[ $(findmnt -no SOURCE /) == /dev/sda7 ]]; then
    local a; a=$(quigon-cgpt show -i 6 -A /dev/sda 2>/dev/null)
    [[ -n $a ]] && [[ $(quigon-cgpt show -i 6 -S /dev/sda) == 1 ]] && pass "KERN-C marked successful (priority $(quigon-cgpt show -i 6 -P /dev/sda))" || fail "KERN-C not marked successful"
  else
    pass "running from $(findmnt -no SOURCE /) (not the internal disk)"
  fi
  for u in seatd quigon-gpu-guard quigon-gpu-confirm.timer quigon-boot-good NetworkManager; do
    systemctl is-enabled -q "$u" 2>/dev/null && pass "$u enabled" || fail "$u not enabled"
  done
  [[ -f /etc/systemd/system/seatd.service.d/novt.conf ]] && pass "seatd SEATD_VTBOUND=0 drop-in" || fail "seatd no-VT drop-in missing"
  [[ -f /etc/systemd/logind.conf.d/30-quigon-lock-key.conf ]] && pass "lock key doesn't suspend (logind drop-in)" || fail "logind lock-key drop-in missing"
  swapon --show=NAME --noheadings | grep -q zram && pass "zram swap active" || fail "zram swap not active"

  if [[ $kver == *-quigon* ]]; then
    section "Mainline kernel"
    local held; held=$(cat /var/lib/quigon/kernel/kern-b 2>/dev/null)
    if grep -q "quigon.default=" /proc/cmdline; then
      pass "booted the default mainline kernel ($(grep -o "quigon\.default=[^ ]*" /proc/cmdline | cut -d= -f2)) from KERN-B"
    elif grep -q "quigon.test=" /proc/cmdline; then
      echo "  · test kernel ($(grep -o "quigon\.test=[^ ]*" /proc/cmdline | cut -d= -f2)); the default comes back after the next boot"
    fi
    [[ $(quigon-cgpt show -i 4 -T /dev/sda 2>/dev/null) -gt 0 || $held == test* ]] && pass "KERN-B armed ($held)" || fail "KERN-B has no tries left: the next boot is the ChromeOS kernel (quigon-kernel status / restore)"
    local l1=/sys/bus/pci/devices/0000:01:00.0/link
    if [[ -r $l1/l1_2_aspm ]]; then
      [[ $(cat $l1/l1_2_aspm) == 0 ]] && pass "Wi-Fi PCIe link: L1.2 off (it hangs s2idle on mainline)$([[ $(cat $l1/l1_1_aspm) == 1 ]] && echo ", L1.1 on")" ||
        fail "Wi-Fi PCIe link has L1.2 on: the next suspend will hang the SoC (echo 0 > $l1/l1_2_aspm)"
    fi
    [[ -e /dev/tpm0 ]] && pass "GSC TPM (/dev/tpm0)" || fail "no /dev/tpm0 (Ti50 TPM, mt8189-quigon-tpm.dtsi / tpm_tis_i2c_cr50)"
    grep -qs "mtk-vcodec-enc" /sys/class/video4linux/video*/name && pass "hardware H.264 encoder" || fail "no mtk-vcodec-enc video device"
  fi

  section "GPU"
  if [[ $kver == *-quigon* ]]; then
    # Mainline kernel: Mesa on Panfrost for everything; the libmali setup below is for the ChromeOS kernel.
    [[ -e /sys/bus/platform/drivers/panfrost/13000000.gpu ]] && pass "mainline kernel: Panfrost drives the Mali-G57" || fail "mainline kernel but Panfrost isn't bound to the GPU"
    if [[ -e /etc/quigon/gpu.env ]]; then
      findmnt -n /etc/quigon/gpu.env >/dev/null && pass "gpu.env masked for this boot (quigon-mainline.service)" || fail "gpu.env not masked: the libmali wrappers would be used on mainline (systemctl start quigon-mainline)"
    fi
    [[ -e /opt/quigon-gpu/mesa-panfrost/lib/libgallium-26.2.4.so ]] && pass "private Panfrost Mesa for Ghostty (GL 4.3)" || fail "no /opt/quigon-gpu/mesa-panfrost: Ghostty renders on llvmpipe (scripts/build-mesa-panfrost.sh)"
  elif [[ -f /etc/quigon/gpu.env ]]; then pass "GPU mode on (/etc/quigon/gpu.env)"; else
    [[ -f /etc/quigon/gpu.env.disabled-unstable ]] && fail "GPU mode turned off by the boot guard (quigon-gpu on)" || fail "GPU mode off"; fi
  local f
  for f in /opt/quigon-gpu/mali/lib/libmali.so.0.54.1.relr /opt/quigon-gpu/lib/egl-mali-shim.so /opt/quigon-gpu/chrome-lib/libEGL.so.1 \
           /opt/quigon-gpu/mali/lib/libminigbm.so.1.0.0.relr /opt/quigon-gpu/lib/ghostty-gpu-preload.so \
           /opt/quigon-gpu/vulkan/layer/libVkLayer_window_system_integration.so /opt/quigon-gpu/mesa-zink/lib/libgallium-26.2.4.so; do
    [[ -e $f ]] && pass "$(basename "$f")" || fail "missing $f"
  done
  [[ -L /etc/vulkan/icd.d/quigon_mali_icd.json && -L /etc/vulkan/implicit_layer.d/quigon_wsi_layer.json ]] && pass "Mali Vulkan ICD + WSI layer registered" || fail "Mali Vulkan ICD/WSI layer not registered"
  pacman -Q libc++ >/dev/null 2>&1 && pass "libc++ installed (libmali needs it)" || fail "libc++ not installed (pacman -S libc++ libc++abi)"
  [[ -f /etc/systemd/user/wayland-wm@hyprland.desktop.service.d/10-quigon-gpu.conf ]] && pass "compositor GPU drop-in" || fail "compositor GPU drop-in missing"

  section "Audio"
  pacman -Q alsa-card-profiles pipewire-pulse >/dev/null 2>&1 && pass "alsa-card-profiles + pipewire-pulse installed" || fail "alsa-card-profiles or pipewire-pulse missing"
  [[ -f /usr/share/alsa/ucm2/conf.d/mt8189_1019_rt5/HiFi.conf ]] && pass "UCM2 profile for mt8189_1019_rt5682s" || fail "UCM2 profile missing (port/quigon/root/usr/share/alsa/ucm2)"

  section "Omarchy patches"
  local qs; qs=$(pacman -Q quickshell 2>/dev/null | awk '{print $2}')
  if grep -q '^IgnorePkg.*quickshell' /etc/pacman.conf && [[ $qs == 0.3.1* ]]; then pass "quickshell $qs pinned (0.3.2 breaks re-locking)"
  else fail "quickshell is $qs / not pinned: 0.3.2 never releases the session lock, so later locks (and lock-before-sleep) fail"; fi
  if [[ -f /etc/pacman.d/hooks/zz-quigon-electron-sync.hook && -x /usr/local/bin/quigon-electron-sync ]]; then
    if (( FIX )); then out=$(/usr/local/bin/quigon-electron-sync); [[ -n $out ]] && repaired "Electron app routing: $out" || pass "Electron apps routed to the GPU (quigon-electron-sync)"
    else pass "Electron app auto-routing installed ($(grep -l '^# generated by quigon-electron-sync' /usr/local/share/applications/*.desktop 2>/dev/null | wc -l) apps)"; fi
  else fail "quigon-electron-sync or its pacman hook missing: new Electron apps will render in software"; fi
  grep -qx 'PasswordAuthentication no' /etc/ssh/sshd_config.d/10-quigon-keys-only.conf 2>/dev/null && pass "SSH is key-only" || fail "SSH accepts passwords (port/quigon/root/etc/ssh/sshd_config.d/10-quigon-keys-only.conf missing)"
  # Hardware video decode in Chrome (notes/video-decode-20261009.md)
  if [[ -e /opt/quigon-gpu/va/v4l2_request_drv_video.so ]]; then
    if LIBVA_DRIVERS_PATH=/opt/quigon-gpu/va LIBVA_DRIVER_NAME=v4l2_request timeout 10 vainfo --display drm --device /dev/dri/renderD128 2>/dev/null | grep -q VAProfileVP9Profile0; then
      pass "hardware video decode driver loads (VA-API v4l2_request: H.264, VP9)"
    else fail "VA-API driver in /opt/quigon-gpu/va doesn't load (libva driver ABI bump? rerun scripts/build-libva-v4l2-request.sh)"; fi
  else fail "no hardware video decode driver: Chrome decodes video on the CPU (scripts/build-libva-v4l2-request.sh)"; fi
  readelf -d /opt/quigon-gpu/chrome-lib/libgbm.so.1 2>/dev/null | grep -q libquigon-minigbm && pass "Chrome's libgbm.so.1 is gbm-linear-shim" ||
    fail "Chrome's libgbm.so.1 is plain minigbm: dma-buf imports and video frames fail (scripts/build-chrome-lib.sh)"
  # ufw on iptables-legacy (no nftables in this kernel); before6.rules must not use ip6t_rt/xt_hl, logging must stay off (no xt_LOG).
  if grep -qE -- '-m (rt|hl) ' /etc/ufw/before6.rules 2>/dev/null; then
    if (( FIX )); then /usr/local/bin/fix-ufw-before6 && repaired "re-applied ufw before6.rules patch (rt/hl matches)"
    else fail "ufw before6.rules uses rt/hl matches this kernel lacks: enabling ufw would block all traffic (sudo fix-ufw-before6)"; fi
  else pass "ufw before6.rules loadable on this kernel"; fi
  grep -q '^LOGLEVEL=off' /etc/ufw/ufw.conf 2>/dev/null && pass "ufw logging off (no xt_LOG in this kernel)" || fail "ufw logging is on: the LOG target is missing here (sudo ufw logging off)"
  iptables -V 2>/dev/null | grep -q legacy && pass "iptables is the legacy backend" || fail "iptables is not iptables-legacy (this kernel has no nftables)"
  # A partial load (ufw.service failed: before.rules missing) still has ufw-user-input but drops all replies.
  if iptables -S ufw-before-input 2>/dev/null | grep -q conntrack; then pass "firewall (ufw) active with its full rule set"
  elif iptables -S ufw-user-input >/dev/null 2>&1; then
    if (( FIX )); then modprobe -a nf_conntrack xt_conntrack && ufw reload >/dev/null && repaired "reloaded half-loaded firewall (conntrack was missing)"
    else fail "firewall only half loaded (no conntrack rules: replies to outgoing traffic are dropped) — sudo ufw reload"; fi
  else fail "firewall (ufw) not active (sudo ufw enable — test over SSH with an auto-revert)"; fi
  [[ -f /etc/modules-load.d/quigon-ufw.conf && -f /etc/systemd/system/ufw.service.d/10-quigon-modules.conf ]] && pass "conntrack loaded before ufw at boot" ||
    fail "ufw boot ordering drop-ins missing: at boot ufw loads before xt_conntrack and only half the firewall comes up"
  grep -q 'quigon/bar-env' /usr/bin/omarchy-launch-shell 2>/dev/null && pass "bar launcher picks its renderer (bar-env)" || { (( FIX )) && /usr/local/bin/fix-omarchy-launch-shell && repaired "re-applied bar launcher patch"; } || fail "omarchy-launch-shell not patched: the bar would inherit Zink and crash (sudo fix-omarchy-launch-shell)"
  if grep -q "/battery_" /usr/bin/omarchy-battery-status 2>/dev/null; then pass "battery panel patch applied"
  elif (( FIX )); then /usr/local/bin/fix-omarchy-battery-status && repaired "re-applied battery panel patch"
  else fail "battery panel patch missing (sudo fix-omarchy-battery-status)"; fi
  local lid=ok s
  for s in omarchy-hw-laptop-closed omarchy-system-lid-close omarchy-hyprland-monitor-clamshell; do
    [[ -x /usr/local/bin/$s && ( -x /usr/share/omarchy/bin/$s || -x /usr/bin/$s ) ]] ||
      lid="$s (quigon shim in /usr/local/bin or Omarchy's own) missing"
  done
  [[ $lid == ok ]] && pass "lid close locks and blanks (SW_LID shims)" || fail "lid: $lid; a lid close won't lock"
  # quigon's patches to Omarchy's own files (lock screen wake key); re-applied by a pacman hook after omarchy updates
  local pout
  pout=$(/usr/local/bin/quigon-omarchy-patches 2>&1)
  if grep -q "no longer applies" <<<"$pout"; then fail "Omarchy patch: $(grep "no longer applies" <<<"$pout" | head -1)"
  else pass "Omarchy patches in place (lock screen wake key)"; fi
  # a Wi-Fi profile pinned to one interface name breaks when the names swap: the USB dongle is wlan0 under mainline,
  # the built-in Wi-Fi is wlan0 under the ChromeOS kernel
  local pinned
  pinned=$(nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1}' |
    while read -r c; do [[ -n $(nmcli -g connection.interface-name con show "$c" 2>/dev/null) ]] && echo x; done | wc -l)
  (( pinned == 0 )) && pass "Wi-Fi profiles not pinned to an interface (built-in and dongle both work)" ||
    fail "$pinned Wi-Fi profile(s) pinned to an interface name: nmcli con mod <name> connection.interface-name \"\""
}

check_session() {
  local u uid home; u=$(desk_user); uid=$(id -u "$u" 2>/dev/null) || return 0; home=$(getent passwd "$u" | cut -d: -f6)
  section "Desktop session ($u)"
  local p; p=$(pgrep -x Hyprland | head -1)
  if [[ -n $p && $(uname -r) == *-quigon* ]]; then
    tr '\0' '\n' < /proc/$p/environ 2>/dev/null | grep -q '^LIBGL_ALWAYS_SOFTWARE=1' && fail "Hyprland is running on llvmpipe (LIBGL_ALWAYS_SOFTWARE set)" || pass "Hyprland is rendering through Mesa on Panfrost"
  elif [[ -n $p ]]; then
    grep -q libmali /proc/$p/maps 2>/dev/null && pass "Hyprland is rendering on the Mali" || fail "Hyprland is running on llvmpipe"
  else fail "Hyprland is not running"; fi
  local qp; qp=$(pgrep -u "$u" -x quickshell | head -1)
  if [[ -z $qp ]]; then fail "Omarchy bar not running (omarchy-restart-shell)"
  elif grep -q libmali /proc/$qp/maps 2>/dev/null; then pass "Omarchy bar running on the GPU (Qt Quick on libmali Vulkan)"
  elif tr '\0' '\n' < /proc/$qp/environ 2>/dev/null | grep -q '^QSG_RHI_BACKEND=opengl'; then pass "Omarchy bar running on the GPU (Qt Quick on OpenGL, Panfrost)"
  elif [[ -e /run/user/$uid/quigon-bar-starts.fellback ]]; then fail "Omarchy bar fell back to software after restarting repeatedly on Vulkan (journalctl -t omarchy-shell -t quigon-bar)"
  else pass "Omarchy bar running (software rendering$([[ -e /etc/quigon/bar-software ]] && echo ', /etc/quigon/bar-software set'))"; fi
  local d
  for d in google-chrome.desktop:quigon-chrome com.mitchellh.ghostty.desktop:quigon-ghostty; do
    grep -q "Exec=/usr/local/bin/${d#*:}" "$home/.local/share/applications/${d%%:*}" 2>/dev/null && pass "${d%%:*} → ${d#*:}" || fail "${d%%:*} override missing (GPU wrapper not used)"
  done
  # Electron apps: the generated /usr/local/share override wins unless a ~/.local one shadows it without the wrapper.
  local e n
  for e in $(grep -l "^# generated by quigon-electron-sync" /usr/local/share/applications/*.desktop 2>/dev/null); do
    n=${e##*/}
    if [[ -f $home/.local/share/applications/$n ]] && ! grep -q "quigon-electron" "$home/.local/share/applications/$n"; then fail "$n: ~/.local/share/applications/$n hides the GPU override (delete it)"
    else pass "$n → quigon-electron"; fi
  done
  grep -q "quigon: Chromebook top row" "$home/.config/hypr/bindings.lua" 2>/dev/null && pass "top-row key binds in bindings.lua" || fail "top-row key binds missing (omarchy refresh hyprland?) — see port/quigon/user/hypr-bindings-quigon.lua"
  grep -q "quigon-gpu-notify" "$home/.config/hypr/autostart.lua" 2>/dev/null && pass "GPU fallback notification in autostart.lua" || fail "quigon-gpu-notify missing from autostart.lua"
  grep -q "hyprpm reload" "$home/.config/hypr/autostart.lua" 2>/dev/null && pass "hyprpm reload in autostart.lua" || fail "hyprpm reload missing from autostart.lua"
  grep -q "quigon-lid-watch" "$home/.config/hypr/autostart.lua" 2>/dev/null && pass "lid watcher in autostart.lua" || fail "quigon-lid-watch missing from autostart.lua: a lid close won't lock (port/quigon/user/hypr-autostart-quigon.lua)"
  if [[ $(uname -r) == *-quigon* ]]; then
    grep -q "quigon/sw-cursor" "$home/.config/hypr/hyprland.lua" 2>/dev/null && pass "cursor block in hyprland.lua (hardware cursor; /etc/quigon/sw-cursor switches to software)" || fail "quigon cursor block missing from hyprland.lua (port/quigon/user/hypr-hyprland-quigon.lua)"
  fi
  local sig plugins
  sig=$(ls -t /run/user/$uid/hypr 2>/dev/null | head -1)
  plugins=$(runuser -u "$u" -- env XDG_RUNTIME_DIR=/run/user/$uid HYPRLAND_INSTANCE_SIGNATURE=$sig hyprctl plugin list 2>/dev/null)
  [[ $plugins == *momentum* ]] && pass "hypr-momentum loaded" || fail "hypr-momentum not loaded (after a Hyprland update run 'hyprpm update' in a terminal)"
  # hypr-tab-drag hooks Hyprland functions, which fails on aarch64 ("could not hook the compositor functions"): not a failure here.
  [[ $plugins == *tab-drag* || $plugins == *tab_drag* ]] && pass "hypr-tab-drag loaded" || echo "  · hypr-tab-drag not loaded (known: its function hooks don't work on ARM)"
  local sinks; sinks=$(runuser -u "$u" -- env XDG_RUNTIME_DIR=/run/user/$uid wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p')
  [[ $sinks == *Speaker* ]] && pass "speaker sink present" || fail "no speaker sink (systemctl --user restart wireplumber pipewire pipewire-pulse)"
}

case $MODE in
  --guard-pacman) check_pacman >/dev/null; exit 0 ;;
  --post-update) check_pacman; check_system ;;
  *) check_pacman; check_system; check_session ;;
esac

echo
echo "quigon-doctor: $ok ok, $fixed repaired, $bad problem(s)$( (( EUID != 0 && bad > 0 )) && echo ' — run with sudo --fix to repair what can be repaired')"
if [[ $MODE == --post-update ]] && (( bad > 0 )); then
  notify_user "After the update: $bad issue(s) on this Chromebook" "$(printf '%s\n' "${problems[@]}" | head -4) — run 'quigon-doctor' in a terminal for details."
fi
(( bad == 0 ))
