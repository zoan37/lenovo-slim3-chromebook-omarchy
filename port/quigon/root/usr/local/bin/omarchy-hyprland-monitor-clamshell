#!/bin/bash
# quigon: Omarchy's clamshell, then switch the laptop panel back on if omarchy-system-lid-close switched it off and the
# lid is open again. Only then: the monitor watcher calls this too, and must not wake a panel the idle timer turned off.
/usr/bin/omarchy-hyprland-monitor-clamshell "$@"
flag=${XDG_RUNTIME_DIR:-/tmp}/quigon-lid-blanked
if [[ -e $flag ]] && ! omarchy-hw-laptop-closed; then
  rm -f "$flag"
  panel=$(omarchy-hyprland-monitor-laptop)
  [[ $panel =~ ^[A-Za-z0-9._-]+$ ]] &&
    hyprctl dispatch "hl.dsp.dpms({ action = \"enable\", monitor = \"$panel\" })" >/dev/null 2>&1
fi
true
