#!/bin/bash
# quigon-electron-sync — put every installed Electron app on the Mali GPU, without per-app setup.
# Electron apps inherit the desktop's Zink defaults, where Chromium's GBM buffers fail and it silently falls back
# to software rendering. They need quigon-electron (libmali ANGLE + minigbm). This finds every desktop entry in
# /usr/share/applications whose program is an Electron/Chromium build (resources.pak + a V8 snapshot next to the
# binary, also through launcher scripts) and generates, as root:
#   /usr/local/share/applications/<name>.desktop  same entry with each Exec= run through quigon-electron
#                                                 (XDG_DATA_DIRS lists /usr/local/share before /usr/share)
#   /usr/local/bin/<cmd>                          when Exec= uses a bare command, a shim for terminals/keybindings
# Generated files carry the marker below and are deleted when their app goes away; anything else is never touched.
# Chrome/Chromium-family browsers are skipped (quigon-chrome). Runs from a pacman hook after every transaction.
#   quigon-electron-sync            sync
#   quigon-electron-sync --status   list detected apps and which running ones have their GPU process on the Mali
MARK="# generated by quigon-electron-sync"
APPS=/usr/share/applications OUT_APPS=/usr/local/share/applications OUT_BIN=/usr/local/bin
SYS_PATH=/usr/bin:/usr/sbin:/bin

is_chromium_dir() { [[ -f $1/resources.pak && ( -f $1/v8_context_snapshot.bin || -f $1/snapshot_blob.bin ) ]]; }
is_browser() { [[ ${1##*/} =~ ^(chrome|chromium|google-chrome.*|brave.*|vivaldi.*|msedge|microsoft-edge.*|opera|helium.*|thorium.*)$ ]]; }

# electron_target <command> → prints the Electron binary it runs, if any
electron_target() {
  local cmd=$1 real c
  [[ $cmd == /* ]] || cmd=$(PATH=$SYS_PATH command -v "$cmd") || return 1
  real=$(readlink -f "$cmd") || return 1
  [[ -f $real ]] || return 1
  if head -c4 "$real" | grep -q $'\x7fELF'; then
    is_browser "$real" && return 1
    is_chromium_dir "$(dirname "$real")" && { echo "$real"; return 0; }
    return 1
  fi
  # A launcher script: look at the absolute paths it mentions (quoted ones may contain spaces).
  head -c 65536 "$real" | grep -a -o -E '"/[^"$]+"|/(opt|usr/lib)/[^ "$;)]+' | tr -d '"' | sort -u | while read -r c; do
    [[ -f $c ]] && head -c4 "$c" | grep -q $'\x7fELF' && ! is_browser "$c" && is_chromium_dir "$(dirname "$c")" && { echo "$c"; break; }
  done | grep . && return 0
  # System Electron (electronNN app.asar)
  grep -a -q -E '(^|[ /])electron[0-9]*( |$)' "$real" && { echo "system electron"; return 0; }
  return 1
}

# first word of an Exec= value (handles "quoted paths")
exec_cmd() { local v=$1; if [[ $v == \"* ]]; then v=${v#\"}; echo "${v%%\"*}"; else echo "${v%% *}"; fi; }

sync() {
  install -d "$OUT_APPS"
  local -A want_apps want_bins
  local f name exec0 cmd tgt
  for f in "$APPS"/*.desktop; do
    [[ -f $f ]] || continue
    exec0=$(sed -n 's/^Exec=//p' "$f" | head -1); [[ -n $exec0 ]] || continue
    cmd=$(exec_cmd "$exec0")
    [[ $cmd == env || $cmd == */env ]] && continue
    tgt=$(electron_target "$cmd") || continue
    name=${f##*/}; want_apps[$name]=1
    if ! [[ -f $OUT_APPS/$name ]] || grep -qxF "$MARK" "$OUT_APPS/$name"; then
      { echo "$MARK from $f"; sed 's|^Exec=|Exec=/usr/local/bin/quigon-electron |; s|^TryExec=.*||' "$f"; } > "$OUT_APPS/$name.tmp"
      cmp -s "$OUT_APPS/$name.tmp" "$OUT_APPS/$name" && rm "$OUT_APPS/$name.tmp" || { mv "$OUT_APPS/$name.tmp" "$OUT_APPS/$name"; echo "quigon-electron-sync: $name → GPU ($tgt)"; }
    fi
    if [[ $cmd != */* ]]; then
      want_bins[$cmd]=1
      if ! [[ -e $OUT_BIN/$cmd ]] || grep -qxF "$MARK" "$OUT_BIN/$cmd"; then
        printf '#!/bin/sh\n%s for %s\nexec /usr/local/bin/quigon-electron %s "$@"\n' "$MARK" "$name" "$(PATH=$SYS_PATH command -v "$cmd")" > "$OUT_BIN/$cmd.tmp"
        chmod 755 "$OUT_BIN/$cmd.tmp"
        cmp -s "$OUT_BIN/$cmd.tmp" "$OUT_BIN/$cmd" && rm "$OUT_BIN/$cmd.tmp" || mv "$OUT_BIN/$cmd.tmp" "$OUT_BIN/$cmd"
      fi
    fi
  done
  # Remove generated files whose app is gone.
  for f in "$OUT_APPS"/*.desktop "$OUT_BIN"/*; do
    [[ -f $f ]] && head -3 "$f" | grep -q "^$MARK" || continue
    if [[ $f == *.desktop ]]; then [[ -n ${want_apps[${f##*/}]} ]] && continue
    else [[ -n ${want_bins[${f##*/}]} ]] && continue; fi
    rm -f "$f"; echo "quigon-electron-sync: removed stale $f"
  done
  command -v update-desktop-database >/dev/null && update-desktop-database -q "$OUT_APPS" 2>/dev/null
  return 0
}

status() {
  local f p exe
  echo "Electron apps routed through quigon-electron:"
  for f in "$OUT_APPS"/*.desktop; do grep -q "^$MARK" "$f" 2>/dev/null && echo "  ${f##*/}"; done
  echo "Running Chromium GPU processes:"
  for p in $(pgrep -f -- '--type=gpu-process'); do
    exe=$(readlink /proc/$p/exe 2>/dev/null) || continue
    grep -q libmali /proc/$p/maps 2>/dev/null && echo "  ✓ Mali   ${exe##*/} (pid $p)" || echo "  ✗ no GPU ${exe##*/} (pid $p): software rendering"
  done
}

case $1 in
  --status) status ;;
  *) (( EUID == 0 )) || { echo "run as root (sudo quigon-electron-sync)"; exit 1; }; sync ;;
esac
