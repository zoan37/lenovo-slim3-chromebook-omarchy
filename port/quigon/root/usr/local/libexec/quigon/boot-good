#!/bin/bash
# Run late in every boot. When the system booted from the internal disk (root on ROOT-C, /dev/sda7), mark KERN-C as a
# known-good kernel and keep it the default: successful=1 and priority above ChromeOS's A/B slots. Until this runs, a
# freshly written KERN-C has tries=1/successful=0, so a failed boot falls back to ChromeOS on its own.
set -u
root=$(findmnt -no SOURCE /)
[[ $root == /dev/sda7 ]] || exit 0
show() { quigon-cgpt show -i "$1" "$2" /dev/sda; }
prio=$(( $(printf '%s\n' "$(show 2 -P)" "$(show 4 -P)" | sort -n | tail -1) + 1 ))
(( prio < $(show 6 -P) )) && prio=$(show 6 -P)
quigon-cgpt add -i 6 -S 1 -T 0 -P "$prio" /dev/sda
echo "quigon-boot-good: KERN-C successful, priority $prio"
