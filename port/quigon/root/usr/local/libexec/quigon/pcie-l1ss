#!/bin/sh
# Called by udev for the MT7922 (14c3:0616) with its sysfs path. On the mainline kernel only: PCIe L1 substates on
# (ChromeOS runs this SoC with them: CONFIG_PCIEASPM_POWER_SUPERSAVE). L1.2 must be off across s2idle (it hangs the
# SoC there); /usr/lib/systemd/system-sleep/quigon-pcie-l1ss switches it off before each sleep and on after.
case $(uname -r) in *-quigon*) ;; *) exit 0 ;; esac
[ -x /usr/lib/systemd/system-sleep/quigon-pcie-l1ss ] || {
  # without the sleep hook, keep L1.2 off for good: the per-link disable has to precede the policy switch
  l=${1:?sysfs path}/link; [ -w "$l/l1_2_aspm" ] && { echo 0 > "$l/l1_2_aspm"; echo 0 > "$l/l1_2_pcipm"; }; }
echo powersupersave > /sys/module/pcie_aspm/parameters/policy
